<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.vehiclegestion.auth.controller.RegisterController"
           prefWidth="1000" prefHeight="700">

    <VBox alignment="CENTER" spacing="0"
          style="-fx-background-color: linear-gradient(to bottom right, #667eea 0%, #764ba2 100%);">

        <VBox alignment="CENTER" spacing="20"
              style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;"
              maxWidth="500">

            <VBox alignment="CENTER" spacing="10">
                <Label text="🚗" style="-fx-font-size: 45px;"/>
                <Label text="Créer un compte" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Label text="Rejoignez notre plateforme" style="-fx-font-size: 13px; -fx-text-fill: gray;"/>
            </VBox>

            <VBox spacing="18">
                <HBox spacing="15">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Nom" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="nomField" promptText="Votre nom" prefHeight="45"/>
                    </VBox>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Prénom" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="prenomField" promptText="Votre prénom" prefHeight="45"/>
                    </VBox>
                </HBox>

                <VBox spacing="8">
                    <Label text="Email" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="emailField" promptText="exemple@email.com" prefHeight="45"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Mot de passe" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="passwordField" promptText="Au moins 6 caractères" prefHeight="45"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Confirmer le mot de passe" style="-fx-font-weight: bold;"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Répétez le mot de passe" prefHeight="45"/>
                </VBox>

                <!-- SECTION TYPE DE COMPTE CORRIGÉE -->
                <VBox spacing="10">
                    <Label text="Type de compte" style="-fx-font-weight: bold;"/>
                    <HBox spacing="15">
                        <RadioButton fx:id="clientRadio" text="Client" selected="true"/>
                        <RadioButton fx:id="vendeurRadio" text="Vendeur"/>
                    </HBox>
                </VBox>
                <!-- FIN SECTION CORRIGÉE -->

                <Label fx:id="errorLabel"
                       style="-fx-text-fill: red; -fx-background-color: #ffebee; -fx-padding: 12; -fx-background-radius: 8;"
                       visible="false" wrapText="true"/>

                <Button text="Créer mon compte" onAction="#handleRegister" maxWidth="Infinity"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"
                        prefHeight="50"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Vous avez déjà un compte ?"/>
                    <Hyperlink text="Se connecter" onAction="#handleGoToLogin"
                               style="-fx-text-fill: #667eea;"/>
                </HBox>
            </VBox>

        </VBox>
    </VBox>
</StackPane>