<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.vendeur.controller.RendezVousListController"
            fitToWidth="true"
            style="-fx-background-color: #f8f9fa;"
            vbarPolicy="AS_NEEDED">

    <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: #f8f9fa;">

        <!-- ============================================ -->
        <!-- HEADER: TITRE À GAUCHE + BOUTONS À DROITE -->
        <!-- ============================================ -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <!-- Titre à gauche -->
            <Label text="📅 Gestion des Rendez-Vous"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;">
                <HBox.hgrow>ALWAYS</HBox.hgrow>
            </Label>

            <!-- Spacer pour pousser les boutons à droite -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Groupe de 3 boutons à droite -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="➕ Ajouter"
                        onAction="#addRendezVous"
                        style="-fx-background-color: linear-gradient(to bottom, #4CAF50, #45a049);
                               -fx-text-fill: white;
                               -fx-padding: 12 24;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 2);"/>

                <Button text="🔄 Actualiser"
                        onAction="#refreshRendezVous"
                        style="-fx-background-color: linear-gradient(to bottom, #2196F3, #1976D2);
                               -fx-text-fill: white;
                               -fx-padding: 12 24;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 2);"/>

                <Button text="📤 Exporter"
                        onAction="#exportRendezVous"
                        style="-fx-background-color: linear-gradient(to bottom, #FF9800, #F57C00);
                               -fx-text-fill: white;
                               -fx-padding: 12 24;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 2);"/>
            </HBox>
        </HBox>

        <!-- ============================================ -->
        <!-- FILTRES: BARRE DE RECHERCHE + FILTRES -->
        <!-- ============================================ -->
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: white;
                     -fx-padding: 20;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">

            <!-- Barre de recherche principale -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-pref-width: 350;">
                <Label text="🔍" style="-fx-font-size: 18px;"/>
                <TextField fx:id="clientFilter"
                           promptText="Rechercher par nom du client..."
                           style="-fx-pref-width: 300;
                                 -fx-padding: 10;
                                 -fx-background-radius: 8;
                                 -fx-border-color: #e0e0e0;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1.5;
                                 -fx-font-size: 13px;"/>
            </HBox>

            <!-- Séparateur vertical -->
            <Separator orientation="VERTICAL" style="-fx-pref-height: 35;"/>

            <!-- Filtres -->
            <Label text="Filtrer par:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #666;"/>

            <ComboBox fx:id="statutFilter"
                      promptText="📊 Statut"
                      style="-fx-pref-width: 150;
                            -fx-background-radius: 8;
                            -fx-border-radius: 8;"/>

            <DatePicker fx:id="dateFilter"
                        promptText="📅 Date"
                        style="-fx-pref-width: 160;
                              -fx-background-radius: 8;"/>
        </HBox>

        <!-- ============================================ -->
        <!-- TABLEAU DES RENDEZ-VOUS MODERNE -->
        <!-- ============================================ -->
        <VBox spacing="15"
              style="-fx-background-color: white;
                     -fx-padding: 25;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">

            <!-- En-tête du tableau -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋 Liste des Rendez-Vous"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text="Total: 0 RDV"
                       style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
            </HBox>

            <Separator style="-fx-background-color: #ecf0f1;"/>

            <!-- Tableau stylé -->
            <TableView fx:id="rdvTable"
                       style="-fx-background-color: transparent;
                 -fx-border-color: transparent;
                 -fx-table-cell-border-color: #f0f0f0;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="idRdv"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colClient" text="👤 Client" prefWidth="160">
                        <cellValueFactory>
                            <PropertyValueFactory property="nomClient"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colArticle" text="🚗 Véhicule" prefWidth="140">
                        <cellValueFactory>
                            <PropertyValueFactory property="titreArticle"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colDate" text="📅 Date" prefWidth="100" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="dateRdv"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colHeure" text="⏰ Heure" prefWidth="80" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="heureRdv"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colType" text="📋 Type" prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="typeRdv"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn fx:id="colStatut" text="🔔 Statut" prefWidth="110" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="statut"/>
                        </cellValueFactory>
                    </TableColumn>

                    <!-- ✅ COLONNE ACTIONS MANQUANTE - À AJOUTER -->
                    <TableColumn fx:id="colActions" text="⚙️ Actions" prefWidth="180" style="-fx-alignment: CENTER;"/>
                </columns>

                <placeholder>
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                        <Label text="📭" style="-fx-font-size: 48px;"/>
                        <Label text="Aucun rendez-vous trouvé"
                               style="-fx-font-size: 16px; -fx-text-fill: #95a5a6;"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- ============================================ -->
        <!-- SECTION CALENDRIER ET STATISTIQUES -->
        <!-- ============================================ -->


    </VBox>
</ScrollPane>