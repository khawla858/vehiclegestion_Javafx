<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.vendeur.controller.VehicleDetailController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- HEADER -->


    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <HBox fx:id="mainContainer" spacing="20" style="-fx-padding: 20;">

                <!-- Section Gauche -->
                <VBox fx:id="leftSection" spacing="20" HBox.hgrow="ALWAYS" style="-fx-max-width: 700;">

                    <!-- Image principale -->
                    <VBox style="
                                 -fx-border-width: 2;
                                 -fx-border-radius: 12;
                                 -fx-padding: 15;
                                 -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.2), 10, 0.5, 0, 3);">
                        <ImageView fx:id="mainImageView" fitWidth="655" fitHeight="455" preserveRatio="true"
                                   style="-fx-background-radius: 8;"/>
                        <HBox spacing="10" style="-fx-padding: 15 0 0 0;">
                            <FontIcon iconLiteral="fas-camera" iconSize="14" iconColor="#94a3b8"/>
                            <Label text="1 image" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                        </HBox>
                    </VBox>

                    <!-- Titre et localisation -->
                    <VBox spacing="10" style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                              -fx-background-radius: 12;
                                              -fx-border-color: #334155;
                                              -fx-border-width: 1;
                                              -fx-border-radius: 12;
                                              -fx-padding: 20;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">
                        <Label fx:id="titleLabel" text="Titre du véhicule" wrapText="true"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="14" iconColor="#3b82f6"/>
                                <Label fx:id="locationLabel" text="Casablanca"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
                            </HBox>
                            <Separator orientation="VERTICAL" prefHeight="15"
                                       style="-fx-background-color: #475569;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-clock" iconSize="14" iconColor="#64748b"/>
                                <Label fx:id="dateLabel" text="Publiée aujourd'hui"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- Caractéristiques -->
                    <VBox fx:id="characteristicsContainer" spacing="12">
                        <!-- Rempli dynamiquement -->
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="12" style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                              -fx-background-radius: 12;
                                              -fx-border-color: #334155;
                                              -fx-border-width: 1;
                                              -fx-border-radius: 12;
                                              -fx-padding: 20;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-align-left" iconSize="18" iconColor="#3b82f6"/>
                            <Label text="DESCRIPTION"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </HBox>
                        <Separator style="-fx-background-color: #475569;"/>
                        <Label fx:id="descriptionLabel" wrapText="true"
                               style="-fx-font-size: 14px; -fx-text-fill: #cbd5e1; -fx-line-spacing: 1.5;"/>
                    </VBox>

                    <!-- SECTION COMMENTAIRES -->
                    <VBox fx:id="commentairesSection" spacing="15">
                        <!-- Rempli dynamiquement -->
                    </VBox>

                </VBox>

                <!-- Section Droite -->
                <VBox spacing="20" style="-fx-min-width: 320; -fx-max-width: 320;">

                    <!-- Prix et actions -->
                    <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                              -fx-background-radius: 12;
                                              -fx-border-color: linear-gradient(to right, #3b82f6, #8b5cf6);
                                              -fx-border-width: 2;
                                              -fx-border-radius: 12;
                                              -fx-padding: 20;
                                              -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 10, 0.5, 0, 3);">
                        <VBox spacing="5" alignment="CENTER_LEFT">
                            <Label fx:id="priceLabel" text="217 000 DH"
                                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <FontIcon iconLiteral="fas-calculator" iconSize="12" iconColor="#94a3b8"/>
                                <Label text="À partir de 4 520 DH / mois"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                            </HBox>
                        </VBox>

                        <Separator style="-fx-padding: 10 0; -fx-background-color: #475569;"/>

                        <Button fx:id="contactBtn" maxWidth="Infinity"
                                style="-fx-background-color: linear-gradient(to right, #3b82f6, #2563eb);
                                       -fx-text-fill: white;
                                       -fx-font-size: 16px;
                                       -fx-font-weight: bold;
                                       -fx-padding: 14 20;
                                       -fx-background-radius: 8;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.5), 10, 0.5, 0, 3);">
                            <graphic>
                                <HBox spacing="10" alignment="CENTER">
                                    <FontIcon iconLiteral="fas-cog" iconSize="16" iconColor="white"/>
                                    <Label text="GÉRER LE VÉHICULE"
                                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>

                        <Button text="✏️ MODIFIER" maxWidth="Infinity"
                                style="-fx-background-color: rgba(51, 65, 85, 0.8);
                                       -fx-text-fill: white;
                                       -fx-font-size: 14px;
                                       -fx-padding: 12 20;
                                       -fx-background-radius: 8;
                                       -fx-cursor: hand;
                                       -fx-border-color: #475569;
                                       -fx-border-width: 1;
                                       -fx-border-radius: 8;"/>

                        <Button maxWidth="Infinity"
                                style="-fx-background-color: transparent;
                                       -fx-border-color: #8b5cf6;
                                       -fx-border-width: 2;
                                       -fx-border-radius: 8;
                                       -fx-text-fill: #8b5cf6;
                                       -fx-font-size: 14px;
                                       -fx-padding: 12 20;
                                       -fx-cursor: hand;
                                       -fx-background-radius: 8;">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER">
                                    <FontIcon iconLiteral="fas-chart-bar" iconSize="14" iconColor="#8b5cf6"/>
                                    <Label text="STATISTIQUES"
                                           style="-fx-text-fill: #8b5cf6; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </VBox>

                    <!-- Informations Vendeur -->
                    <VBox fx:id="sellerSection" spacing="15"
                          style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                 -fx-background-radius: 12;
                                 -fx-border-color: #334155;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 12;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">
                        <!-- Rempli dynamiquement -->
                    </VBox>

                    <!-- Statistiques -->
                    <VBox spacing="12" style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                              -fx-background-radius: 12;
                                              -fx-border-color: #334155;
                                              -fx-border-width: 1;
                                              -fx-border-radius: 12;
                                              -fx-padding: 20;
                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-chart-pie" iconSize="16" iconColor="#3b82f6"/>
                            <Label text="STATISTIQUES"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: white;"/>
                        </HBox>
                        <Separator style="-fx-background-color: #475569;"/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-eye" iconSize="16" iconColor="#94a3b8"/>
                            <Label text="1 234 vues" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px;"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-heart" iconSize="16" iconColor="#94a3b8"/>
                            <Label text="67 favoris" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px;"/>
                        </HBox>
                    </VBox>

                </VBox>

            </HBox>
        </ScrollPane>
    </center>

</BorderPane>