<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.vehiclegestion.vendeur.controller.EditVehicleFormController"
            prefWidth="900" prefHeight="720"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- HEADER -->
    <top>
        <VBox spacing="10" style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-border-color: #3b82f6; -fx-border-width: 0 0 2 0; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="✏️" style="-fx-font-size: 28px;"/>
                <Label fx:id="formTitleLabel" text="Modifier le véhicule"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <Label fx:id="messageLabel" wrapText="true" maxWidth="Infinity" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 25;">

                <!-- SECTION INFORMATIONS GÉNÉRALES -->
                <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 25; -fx-background-radius: 10; -fx-border-color: #10b981; -fx-border-width: 2; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

                    <Label text="📋 Informations Générales"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Separator style="-fx-background-color: #10b981;"/>

                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <!-- Ligne 1 -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Titre du véhicule *"
                                   style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="titreField" promptText="Ex: BMW Série 3"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Prix (DH) *"
                                   style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="prixField" promptText="Ex: 250000"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>

                        <!-- Ligne 2 -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Catégorie *"
                                   style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <ComboBox fx:id="categorieComboBox" promptText="Sélectionner"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="État *"
                                   style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <ComboBox fx:id="etatComboBox" promptText="Sélectionner"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                        </VBox>

                        <!-- Ligne 3 -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                            <Label text="Description *"
                                   style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextArea fx:id="descriptionField" promptText="Décrivez le véhicule..."
                                      wrapText="true" prefRowCount="4"
                                      style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- SECTION CARACTÉRISTIQUES TECHNIQUES -->
                <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 25; -fx-background-radius: 10; -fx-border-color: #3b82f6; -fx-border-width: 2; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

                    <Label text="🔧 Caractéristiques Techniques"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Separator style="-fx-background-color: #3b82f6;"/>

                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="33"/>
                            <ColumnConstraints percentWidth="34"/>
                        </columnConstraints>

                        <!-- Ligne 1 -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Marque" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="marqueField" promptText="Ex: BMW"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Modèle" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="modeleField" promptText="Ex: Série 3"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Année" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="anneeField" promptText="Ex: 2023"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>

                        <!-- Ligne 2 -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Kilométrage (km)" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="kilometrageField" promptText="Ex: 50000"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Transmission" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <ComboBox fx:id="transmissionComboBox" promptText="Sélectionner"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label text="Carburant" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <ComboBox fx:id="carburantComboBox" promptText="Sélectionner"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;"/>
                        </VBox>

                        <!-- Ligne 3 -->
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Puissance (ch)" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="puissanceField" promptText="Ex: 150"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label text="Couleur" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="couleurField" promptText="Ex: Noir"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- SECTION TARIFICATION -->
                <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 25; -fx-background-radius: 10; -fx-border-color: #f59e0b; -fx-border-width: 2; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

                    <Label text="💰 Tarification et Promotions"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Separator style="-fx-background-color: #f59e0b;"/>

                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Réduction (%)"
                                   style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="reductionField" promptText="Ex: 10"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>

                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Prix Promo (DH)"
                                   style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                            <TextField fx:id="prixPromoField" promptText="Ex: 225000"
                                       style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- SECTION IMAGE -->
                <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 25; -fx-background-radius: 10; -fx-border-color: #8b5cf6; -fx-border-width: 2; -fx-border-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

                    <Label text="📸 Image du Véhicule"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Separator style="-fx-background-color: #8b5cf6;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <TextField fx:id="imageField" promptText="Aucune image sélectionnée"
                                   editable="false" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-padding: 10;"/>

                        <Button text="📁 Parcourir" onAction="#browseImage"
                                style="-fx-background-color: linear-gradient(to right, #8b5cf6, #d946ef); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(139, 92, 246, 0.5), 8, 0.5, 0, 2);"/>
                    </HBox>

                    <VBox fx:id="imagePreviewContainer" spacing="10" alignment="CENTER"
                          style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #475569; -fx-border-radius: 8;">

                        <Label text="Aperçu de l'image"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #cbd5e1;"/>

                        <ImageView fx:id="imagePreview" fitWidth="400" fitHeight="300" preserveRatio="true"
                                   style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"/>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- FOOTER - BUTTONS -->
    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT"
              style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-border-color: #334155; -fx-border-width: 2 0 0 0; -fx-padding: 20 30;">

            <Button fx:id="cancelButton" text="❌ Annuler" onAction="#cancel"
                    prefWidth="150"
                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="saveButton" text="✅ Enregistrer les modifications" onAction="#saveChanges"
                    prefWidth="250"
                    style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.5), 8, 0.5, 0, 2);"/>
        </HBox>
    </bottom>

</BorderPane>