<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.vendeur.controller.VendeurVehicleController"
            fitToWidth="true"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);"
            vbarPolicy="AS_NEEDED">

    <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: transparent;">

        <!-- TITRE DE LA PAGE -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="🚗 MES VÉHICULES"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 32px;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 5, 0.5, 0, 2);"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="addVehicleButton" text="➕ Ajouter un véhicule" onAction="#addVehicle"
                    style="-fx-background-color: linear-gradient(to right, #10b981, #059669);
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;
                           -fx-padding: 12 24;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.5), 10, 0.5, 0, 3);"/>
        </HBox>

        <!-- FILTRES ET RECHERCHE -->
        <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.8);
                                  -fx-background-radius: 12;
                                  -fx-border-color: #334155;
                                  -fx-border-width: 1;
                                  -fx-border-radius: 12;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="🔍 RECHERCHE ET FILTRES"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="🔍 Rechercher par titre, marque ou modèle..."
                           prefWidth="350"
                           style="-fx-background-color: #1e293b; -fx-text-fill: white;
                                  -fx-border-color: #475569; -fx-border-radius: 8px;
                                  -fx-background-radius: 8px; -fx-padding: 10px;
                                  -fx-prompt-text-fill: #64748b;"/>

                <VBox spacing="3">
                    <Label text="Catégorie" style="-fx-font-size: 11px; -fx-text-fill: #cbd5e1;"/>
                    <ComboBox fx:id="categorieCombo" promptText="Toutes" prefWidth="140"
                              style="-fx-background-color: #1e293b; -fx-text-fill: white;
                                     -fx-border-color: #475569; -fx-border-radius: 8px;
                                     -fx-background-radius: 8px;"/>
                </VBox>

                <VBox spacing="3">
                    <Label text="État" style="-fx-font-size: 11px; -fx-text-fill: #cbd5e1;"/>
                    <ComboBox fx:id="etatCombo" promptText="Tous" prefWidth="120"
                              style="-fx-background-color: #1e293b; -fx-text-fill: white;
                                     -fx-border-color: #475569; -fx-border-radius: 8px;
                                     -fx-background-radius: 8px;"/>
                </VBox>

                <VBox spacing="3">
                    <Label text="Année Max" style="-fx-font-size: 11px; -fx-text-fill: #cbd5e1;"/>
                    <ComboBox fx:id="anneeMaxCombo" promptText="Toutes" prefWidth="100"
                              style="-fx-background-color: #1e293b; -fx-text-fill: white;
                                     -fx-border-color: #475569; -fx-border-radius: 8px;
                                     -fx-background-radius: 8px;"/>
                </VBox>

                <Button text="Réinitialiser"
                        onAction="#resetFilters"
                        style="-fx-background-color: linear-gradient(to right, #64748b, #475569);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 20;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="resultsLabel" text="0 véhicule(s) trouvé(s)"
                       style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>

        <!-- SECTION VÉHICULES -->
        <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.8);
                                  -fx-background-radius: 12;
                                  -fx-border-color: #334155;
                                  -fx-border-width: 1;
                                  -fx-border-radius: 12;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Conteneur des cartes -->
            <VBox fx:id="cardsContainer" spacing="20" alignment="CENTER" style="-fx-padding: 10;"/>
        </VBox>

    </VBox>
</ScrollPane>