<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.vendeur.controller.VentesListController"
            fitToWidth="true"
            style="-fx-background-color: #f8fafc;"
            vbarPolicy="AS_NEEDED">

    <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: #f8fafc;">

        <!-- ============================================ -->
        <!-- HEADER: TITRE + STATISTIQUES RAPIDES -->
        <!-- ============================================ -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="💰 Gestion des Ventes"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;">
                <HBox.hgrow>ALWAYS</HBox.hgrow>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- ============================================ -->
        <!-- STATISTIQUES GLOBALES -->
        <!-- ============================================ -->
        <HBox spacing="20" alignment="CENTER" style="-fx-background-color: white;
                     -fx-padding: 30 25;
                     -fx-background-radius: 16;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">

            <!-- Stat 1: Total Ventes -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="220">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: #dbeafe;
                                 -fx-background-radius: 12;
                                 -fx-padding: 12;">
                        <Label text="📊" style="-fx-font-size: 28px;"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Total Ventes"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="totalVentesLabel" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                </HBox>
                <ProgressBar progress="1.0" prefWidth="200" prefHeight="4"
                             style="-fx-accent: #3b82f6; -fx-background-radius: 2;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 60; -fx-background-color: #e2e8f0;"/>

            <!-- Stat 2: Chiffre d'Affaires -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="220">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: #dcfce7;
                                 -fx-background-radius: 12;
                                 -fx-padding: 12;">
                        <Label text="💰" style="-fx-font-size: 28px;"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Chiffre d'Affaires"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="chiffreAffairesLabel" text="0 DH"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                </HBox>
                <ProgressBar progress="0.85" prefWidth="200" prefHeight="4"
                             style="-fx-accent: #10b981; -fx-background-radius: 2;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 60; -fx-background-color: #e2e8f0;"/>

            <!-- Stat 3: Ventes en Cours -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="220">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: #fef3c7;
                                 -fx-background-radius: 12;
                                 -fx-padding: 12;">
                        <Label text="⏳" style="-fx-font-size: 28px;"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="En Cours"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="ventesEnCoursLabel" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                </HBox>
                <ProgressBar progress="0.60" prefWidth="200" prefHeight="4"
                             style="-fx-accent: #f59e0b; -fx-background-radius: 2;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 60; -fx-background-color: #e2e8f0;"/>

            <!-- Stat 4: Ventes Terminées -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="220">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: #e0e7ff;
                                 -fx-background-radius: 12;
                                 -fx-padding: 12;">
                        <Label text="✅" style="-fx-font-size: 28px;"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Terminées"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="ventesTermineesLabel" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                </HBox>
                <ProgressBar progress="0.75" prefWidth="200" prefHeight="4"
                             style="-fx-accent: #6366f1; -fx-background-radius: 2;"/>
            </VBox>
        </HBox>

        <!-- ============================================ -->
        <!-- BARRE DE RECHERCHE ET FILTRES -->
        <!-- ============================================ -->
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: white;
                     -fx-padding: 20;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

            <!-- Recherche -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-pref-width: 320;">
                <Label text="🔍" style="-fx-font-size: 18px;"/>
                <TextField fx:id="searchField"
                           promptText="Rechercher par client, article..."
                           style="-fx-pref-width: 280;
                                 -fx-padding: 10;
                                 -fx-background-radius: 8;
                                 -fx-border-color: #cbd5e1;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1.5;
                                 -fx-font-size: 13px;"/>
            </HBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 35;"/>

            <!-- Filtre Statut -->
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Statut:"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                <ComboBox fx:id="filterStatutComboBox"
                          promptText="📊 Statut vente"
                          style="-fx-pref-width: 160;
                                -fx-background-radius: 8;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 35;"/>

            <!-- Filtre Magasin -->
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Magasin:"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                <ComboBox fx:id="filterMagasinComboBox"
                          promptText="🏪 Tous les magasins"
                          style="-fx-pref-width: 180;
                                -fx-background-radius: 8;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 35;"/>

            <!-- Filtre Date -->
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Période:"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                <ComboBox fx:id="filterDateComboBox"
                          promptText="📅 Période"
                          style="-fx-pref-width: 150;
                                -fx-background-radius: 8;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Boutons d'action -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="🔄 Actualiser"
                        onAction="#refreshVentes"
                        style="-fx-background-color: #3b82f6;
                               -fx-text-fill: white;
                               -fx-padding: 12 24;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 8, 0, 0, 2);"/>

                <Button text="📤 Exporter"
                        onAction="#exportVentes"
                        style="-fx-background-color: #0f172a;
                               -fx-text-fill: white;
                               -fx-padding: 12 24;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
            </HBox>
        </HBox>

        <!-- ============================================ -->
        <!-- TABLEAU DES VENTES -->
        <!-- ============================================ -->
        <VBox spacing="15"
              style="-fx-background-color: white;
                     -fx-padding: 25;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

            <!-- En-tête du tableau -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋 Historique des Ventes"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text="Total: 0 ventes"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
            </HBox>

            <Separator style="-fx-background-color: #e2e8f0;"/>

            <!-- Tableau des ventes -->
            <TableView fx:id="ventesTable"
                       style="-fx-background-color: transparent;
                             -fx-border-color: transparent;
                             -fx-table-cell-border-color: #f1f5f9;">
                <columns>
                    <TableColumn text="ID" prefWidth="60" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="idVente"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="📅 Date Vente" prefWidth="130" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="dateVente"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="👤 Client" prefWidth="180">
                        <cellValueFactory>
                            <PropertyValueFactory property="nomClient"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="🚗 Article Vendu" prefWidth="220">
                        <cellValueFactory>
                            <PropertyValueFactory property="nomArticle"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="🏪 Magasin" prefWidth="160">
                        <cellValueFactory>
                            <PropertyValueFactory property="nomMagasin"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="💰 Montant" prefWidth="120" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="montantTotal"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="💳 Paiement" prefWidth="130" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="moyenPaiement"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="📊 Statut" prefWidth="120" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="statutVente"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="⚙️ Actions" prefWidth="140" style="-fx-alignment: CENTER;">
                        <!-- Actions seront gérées par le contrôleur -->
                    </TableColumn>
                </columns>

                <placeholder>
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                        <Label text="💰" style="-fx-font-size: 48px; -fx-opacity: 0.5;"/>
                        <Label text="Aucune vente trouvée"
                               style="-fx-font-size: 16px; -fx-text-fill: #64748b;"/>
                        <Label text="Les ventes apparaîtront ici une fois enregistrées"
                               style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- ============================================ -->
        <!-- CARTES INSIGHTS (EN BAS) -->
        <!-- ============================================ -->
        <HBox spacing="20">
            <!-- Top 5 Articles les Plus Vendus -->
            <VBox spacing="15" prefWidth="450"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🏆 Top 5 Articles Vendus"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </HBox>

                <Separator style="-fx-background-color: #e2e8f0;"/>

                <ListView fx:id="topArticlesList"
                          style="-fx-pref-height: 200;
                                -fx-background-radius: 8;
                                -fx-border-color: #e2e8f0;
                                -fx-border-radius: 8;"/>
            </VBox>

            <!-- Ventes Récentes -->
            <VBox spacing="15" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔔 Ventes Récentes"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </HBox>

                <Separator style="-fx-background-color: #e2e8f0;"/>

                <ListView fx:id="recentVentesList"
                          style="-fx-pref-height: 200;
                                -fx-background-radius: 8;
                                -fx-border-color: #e2e8f0;
                                -fx-border-radius: 8;"/>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>