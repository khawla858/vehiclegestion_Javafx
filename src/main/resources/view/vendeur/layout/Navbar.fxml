<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.vehiclegestion.vendeur.controller.layout.NavbarController"
      spacing="0"
      style="-fx-background-color: #ffffff;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

    <!-- ============================================ -->
    <!-- NIVEAU 1 : HEADER (Logo + Recherche + Actions) -->
    <!-- ============================================ -->

    <HBox spacing="0"
          alignment="CENTER"
          style="-fx-padding: 12 25; -fx-background-color: #ffffff;">

        <!-- LOGO + NOM -->
        <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <StackPane style="-fx-background-color: linear-gradient(to bottom right, #3498db, #2980b9);
                              -fx-background-radius: 10;
                              -fx-pref-width: 45;
                              -fx-pref-height: 45;
                              -fx-effect: dropshadow(gaussian, rgba(52, 152, 219, 0.3), 8, 0, 0, 2);">
                <FontIcon iconLiteral="fas-car-side" iconSize="24" iconColor="white"/>
            </StackPane>

            <VBox spacing="2">
                <Label text="AutoSales Pro"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;"/>
                <Label text="Gestion Automobile"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #95a5a6;"/>
            </VBox>
        </HBox>

        <!-- BARRE DE RECHERCHE CENTRALE -->
        <HBox spacing="0"
              alignment="CENTER"
              style="-fx-background-color: #f8f9fa;
                     -fx-background-radius: 25;
                     -fx-padding: 10 20;
                     -fx-border-color: #e0e0e0;
                     -fx-border-radius: 25;
                     -fx-border-width: 1;
                     -fx-min-width: 450;">
            <FontIcon iconLiteral="fas-search" iconSize="16" iconColor="#95a5a6"/>
            <TextField fx:id="searchField"
                       promptText="Rechercher véhicule, client, commande..."
                       style="-fx-background-color: transparent;
                              -fx-border-width: 0;
                              -fx-pref-width: 380;
                              -fx-padding: 0 12;
                              -fx-font-size: 14px;"/>
            <Button text="Rechercher"
                    onAction="#performSearch"
                    style="-fx-background-color: #3498db;
                           -fx-text-fill: white;
                           -fx-font-size: 12px;
                           -fx-font-weight: 600;
                           -fx-background-radius: 20;
                           -fx-padding: 6 16;
                           -fx-cursor: hand;"/>
        </HBox>

        <!-- ACTIONS DROITE -->
        <HBox spacing="15" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <!-- PANIER -->
            <StackPane style="-fx-cursor: hand;" onMouseClicked="#showCart">
                <StackPane style="-fx-background-color: transparent;
                                  -fx-pref-width: 42;
                                  -fx-pref-height: 42;">
                    <FontIcon iconLiteral="fas-shopping-cart" iconSize="20" iconColor="#7f8c8d"/>
                </StackPane>
                <Label text="2"
                       style="-fx-text-fill: white;
                              -fx-font-size: 9px;
                              -fx-font-weight: bold;
                              -fx-translate-x: 12;
                              -fx-translate-y: -12;
                              -fx-background-color: #e74c3c;
                              -fx-background-radius: 10;
                              -fx-padding: 2 6;
                              -fx-min-width: 18;
                              -fx-alignment: center;"/>
            </StackPane>

            <!-- NOTIFICATIONS (nouvelle version avec dropdown) -->
            <StackPane style="-fx-cursor: hand;">
                <Button fx:id="notificationBtn"
                        onAction="#toggleNotificationDropdown"
                        style="-fx-background-color: transparent;
                               -fx-border-width: 0;
                               -fx-padding: 8;">
                    <graphic>
                        <StackPane style="
                                      -fx-background-radius: 50;
                                      -fx-pref-width: 42;
                                      -fx-pref-height: 42;">
                            <FontIcon iconLiteral="far-bell" iconSize="18" iconColor="#7f8c8d"/>
                        </StackPane>
                    </graphic>
                </Button>
                <Label fx:id="notificationBadge"
                       text="0"
                       style="-fx-text-fill: white;
                              -fx-font-size: 9px;
                              -fx-font-weight: bold;
                              -fx-translate-x: 12;
                              -fx-translate-y: -12;
                              -fx-background-color: #e74c3c;
                              -fx-background-radius: 10;
                              -fx-padding: 2 6;
                              -fx-min-width: 18;
                              -fx-alignment: center;
                              -fx-visible: false;"/>
            </StackPane>

            <!-- MESSAGES -->
            <StackPane style="-fx-cursor: hand;" onMouseClicked="#showMessages">
                <StackPane style="-fx-background-radius: 50;
                                  -fx-pref-width: 42;
                                  -fx-pref-height: 42;">
                    <FontIcon iconLiteral="far-envelope" iconSize="18" iconColor="#7f8c8d"/>
                </StackPane>
                <Label fx:id="messageBadge"
                       text="0"
                       visible="false"
                       style="-fx-text-fill: white;
                              -fx-font-size: 9px;
                              -fx-font-weight: bold;
                              -fx-translate-x: 12;
                              -fx-translate-y: -12;
                              -fx-background-color: #3498db;
                              -fx-background-radius: 10;
                              -fx-padding: 2 6;
                              -fx-min-width: 18;
                              -fx-alignment: center;"/>
            </StackPane>

            <!-- SÉPARATEUR -->
            <Separator orientation="VERTICAL"
                       style="-fx-pref-height: 35; -fx-background-color: #e0e0e0;"/>

            <!-- PROFIL UTILISATEUR -->
            <MenuButton fx:id="profileMenu"
                        style="-fx-background-color: transparent;
                               -fx-border-color: transparent;
                               -fx-cursor: hand;">
                <graphic>
                    <HBox spacing="12" alignment="CENTER">
                        <!-- Avatar -->
                        <StackPane style="-fx-background-color: linear-gradient(to bottom right, #3498db, #2980b9);
                                          -fx-background-radius: 50;
                                          -fx-pref-width: 42;
                                          -fx-pref-height: 42;
                                          -fx-effect: dropshadow(gaussian, rgba(52, 152, 219, 0.3), 6, 0, 0, 2);">
                            <Label text="JD"
                                   style="-fx-text-fill: white;
                                          -fx-font-weight: bold;
                                          -fx-font-size: 15px;"/>
                        </StackPane>

                        <!-- Infos -->
                        <VBox spacing="2" alignment="CENTER_LEFT">
                            <Label fx:id="userNameLabel"
                                   text="John Doe"
                                   style="-fx-text-fill: #2c3e50;
                                          -fx-font-weight: 600;
                                          -fx-font-size: 14px;"/>
                            <Label fx:id="userRoleLabel"
                                   text="Vendeur"
                                   style="-fx-text-fill: #95a5a6;
                                          -fx-font-size: 11px;"/>
                        </VBox>

                        <FontIcon iconLiteral="fas-chevron-down" iconSize="10" iconColor="#95a5a6"/>
                    </HBox>
                </graphic>

                <items>
                    <MenuItem text="Mon Profil" onAction="#showUserProfile">
                        <graphic><FontIcon iconLiteral="fas-user" iconSize="14" iconColor="#3498db"/></graphic>
                    </MenuItem>
                    <MenuItem text="Paramètres" onAction="#showAccountSettings">
                        <graphic><FontIcon iconLiteral="fas-cog" iconSize="14" iconColor="#7f8c8d"/></graphic>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="Déconnexion" onAction="#handleLogout">
                        <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="14" iconColor="#e74c3c"/></graphic>
                    </MenuItem>
                </items>
            </MenuButton>
        </HBox>
    </HBox>

    <!-- SÉPARATEUR -->
    <Separator style="-fx-background-color: #e8ecef; -fx-pref-height: 1;"/>

    <!-- ============================================ -->
    <!-- NIVEAU 2 : MENU NAVIGATION PRINCIPAL -->
    <!-- ============================================ -->
    <HBox spacing="0"
          alignment="CENTER_LEFT"
          style="-fx-padding: 0 27; -fx-background-color: #ffffff;">

        <!-- Dashboard -->
        <Button fx:id="dashboardBtn"
                onAction="#showDashboard"
                styleClass="nav-item-btn"
                style="-fx-background-color: transparent;
                       -fx-border-width: 0;
                       -fx-padding: 16 20;
                       -fx-cursor: hand;">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <Label text="Dashboard"
                           style="-fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-font-weight: 500;"/>
                </HBox>
            </graphic>
        </Button>

        <!-- Véhicules -->
        <Button onAction="#showVehicleManagement"
                styleClass="nav-item-btn"
                style="-fx-background-color: transparent;
                       -fx-border-width: 0;
                       -fx-padding: 16 20;
                       -fx-cursor: hand;">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <Label text="Home"
                           style="-fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-font-weight: 500;"/>
                </HBox>
            </graphic>
        </Button>

        <!-- Clients -->
        <Button onAction="#showCustomerList"
                styleClass="nav-item-btn"
                style="-fx-background-color: transparent;
                       -fx-border-width: 0;
                       -fx-padding: 16 20;
                       -fx-cursor: hand;">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <Label text="Mes ventes"
                           style="-fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-font-weight: 500;"/>
                </HBox>
            </graphic>
        </Button>

        <!-- Ventes -->


        <!-- Rendez-vous -->
        <Button onAction="#showRendezVous"
                styleClass="nav-item-btn"
                style="-fx-background-color: transparent;
                       -fx-border-width: 0;
                       -fx-padding: 16 20;
                       -fx-cursor: hand;">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <Label text="Rendez-vous"
                           style="-fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-font-weight: 500;"/>
                </HBox>
            </graphic>
        </Button>

        <!-- Magasins -->
        <Button onAction="#showMagasins"
                styleClass="nav-item-btn"
                style="-fx-background-color: transparent;
                       -fx-border-width: 0;
                       -fx-padding: 16 20;
                       -fx-cursor: hand;">
            <graphic>
                <HBox spacing="8" alignment="CENTER">
                    <Label text="Magasins"
                           style="-fx-text-fill: #2c3e50; -fx-font-size: 14px; -fx-font-weight: 500;"/>
                </HBox>
            </graphic>
        </Button>
    </HBox>

    <!-- LIGNE INFÉRIEURE -->
    <Separator style="-fx-background-color: #e8ecef; -fx-pref-height: 1;"/>

    <!-- DROPDOWN DES NOTIFICATIONS -->
    <BorderPane fx:id="notificationDropdown"
                visible="false"
                managed="false"
                style="-fx-background-color: white;
                      -fx-border-color: #e0e0e0;
                      -fx-border-width: 1;
                      -fx-background-radius: 8;
                      -fx-border-radius: 8;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                prefWidth="380"
                prefHeight="500"
                maxWidth="400"
                maxHeight="600"
                minHeight="400"
                translateY="65"
                translateX="-180">

        <top>
            <HBox style="-fx-background-color: #f8f9fa;
                         -fx-border-width: 0 0 1 0;
                         -fx-border-color: #e0e0e0;
                         -fx-padding: 20;
                         -fx-border-radius: 8 8 0 0;">
                <Label text="🔔 Notifications"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnMarkAllRead" text="Tout lire"
                        style="-fx-background-color: #3498db;
                              -fx-text-fill: white;
                              -fx-padding: 8 20;
                              -fx-font-size: 14px;
                              -fx-background-radius: 6;"/>
            </HBox>
        </top>

        <center>
            <ScrollPane fx:id="notificationScrollPane"
                        style="-fx-background: transparent;
                               -fx-border-width: 0;
                               -fx-padding: 0;"
                        fitToWidth="true"
                        vbarPolicy="AS_NEEDED"
                        hbarPolicy="NEVER">
                <VBox fx:id="notificationItemsContainer" spacing="0"/>
            </ScrollPane>
        </center>

        <bottom>
            <HBox style="-fx-background-color: #f8f9fa;
                         -fx-border-width: 1 0 0 0;
                         -fx-border-color: #e0e0e0;
                         -fx-padding: 15 20;">
                <Label fx:id="lblNotificationStatus" text="0 notification(s)"
                       style="-fx-text-fill: #666; -fx-font-size: 14px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSeeAll" text="Voir tout"
                        style="-fx-background-color: transparent;
                              -fx-text-fill: #3498db;
                              -fx-padding: 8 15;
                              -fx-font-size: 14px;
                              -fx-font-weight: 500;"/>
            </HBox>
        </bottom>
    </BorderPane>

</VBox>