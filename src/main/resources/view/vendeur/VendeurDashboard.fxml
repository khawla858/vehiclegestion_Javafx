<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<ScrollPane
        xmlns="http://javafx.com/javafx/11.0.1"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.vehiclegestion.vendeur.controller.VendeurDashboardController"
        fitToWidth="true">

    <VBox spacing="25" style="-fx-padding: 25;">

        <!-- 🔹 STATISTIQUES -->
        <HBox alignment="CENTER" spacing="15">

            <VBox alignment="CENTER" spacing="10">
                <Label text="Ventes totales"/>
                <Label fx:id="totalSalesLabel" text="0"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Label text="Revenus"/>
                <Label fx:id="revenueLabel" text="0 MAD"/>
            </VBox>



            <VBox alignment="CENTER" spacing="10">
                <Label text="Clients actifs"/>
                <Label fx:id="activeClientsLabel" text="0"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Label text="Commandes en attente"/>
                <Label fx:id="pendingOrdersLabel" text="0"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Label text="Total articles"/>
                <Label fx:id="totalArticlesLabel" text="0"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Label text="Articles disponibles"/>
                <Label fx:id="availableArticlesLabel" text="0"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <Label text="Note moyenne"/>
                <Label fx:id="avgRatingLabel" text="0.0"/>
            </VBox>

        </HBox>

        <!-- 🔹 GRAPHIQUE DES VENTES -->
        <LineChart fx:id="salesChart" prefHeight="300">
            <xAxis>
                <CategoryAxis label="Mois"/>
            </xAxis>
            <yAxis>
                <NumberAxis label="Ventes"/>
            </yAxis>
        </LineChart>

        <!-- 🔹 AUTRES GRAPHIQUES -->
        <HBox spacing="20">

            <PieChart fx:id="productsPieChart" prefWidth="300"/>

            <StackedBarChart fx:id="categorySalesChart" prefWidth="400">
                <xAxis>
                    <CategoryAxis/>
                </xAxis>
                <yAxis>
                    <NumberAxis/>
                </yAxis>
            </StackedBarChart>

        </HBox>

        <!-- 🔹 ACTIVITÉS -->
        <VBox spacing="10">
            <Label text="Activités récentes"/>
            <ScrollPane fitToWidth="true" prefHeight="200">
                <VBox fx:id="activitiesContainer" spacing="8"/>
            </ScrollPane>
        </VBox>

        <!-- 🔹 STATUT SYSTÈME -->
        <VBox spacing="6">
            <Label text="Statut système"/>
            <Label fx:id="systemStatusValue" text="OK"/>
            <Label fx:id="systemStatusDesc" text="Système opérationnel"/>
        </VBox>

    </VBox>

</ScrollPane>
