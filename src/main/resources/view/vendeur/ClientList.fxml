<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.vendeur.controller.ClientListController"
            fitToWidth="true"
            style="-fx-background-color: #f8fafc;"
            vbarPolicy="AS_NEEDED">

    <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: #f8fafc;">

        <!-- ============================================ -->
        <!-- HEADER: TITRE À GAUCHE + BOUTONS À DROITE -->
        <!-- ============================================ -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="👥 Gestion des Clients"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;">
                <HBox.hgrow>ALWAYS</HBox.hgrow>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- ============================================ -->
        <!-- STATISTIQUES STYLE MODERNE (INLINE) -->
        <!-- ============================================ -->
        <HBox spacing="20" alignment="CENTER" style="-fx-background-color: white;
                     -fx-padding: 30 25;
                     -fx-background-radius: 16;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 15, 0, 0, 3);">

            <!-- Stat 1: Total Clients -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="200">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: #dbeafe;
                                 -fx-background-radius: 12;
                                 -fx-padding: 12;">
                        <Label text="👥" style="-fx-font-size: 28px;"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Clients Totaux"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="totalClientsLabel" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                </HBox>
                <ProgressBar progress="1.0" prefWidth="180" prefHeight="4"
                             style="-fx-accent: #3b82f6; -fx-background-radius: 2;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 60; -fx-background-color: #e2e8f0;"/>

            <!-- Stat 2: Clients Actifs -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="200">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: #dcfce7;
                                 -fx-background-radius: 12;
                                 -fx-padding: 12;">
                        <Label text="⭐" style="-fx-font-size: 28px;"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Clients Actifs"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="activeClientsLabel" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                </HBox>
                <ProgressBar progress="0.75" prefWidth="180" prefHeight="4"
                             style="-fx-accent: #10b981; -fx-background-radius: 2;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 60; -fx-background-color: #e2e8f0;"/>

            <!-- Stat 3: Acheteurs -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="200">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: #fef3c7;
                                 -fx-background-radius: 12;
                                 -fx-padding: 12;">
                        <Label text="🛒" style="-fx-font-size: 28px;"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Acheteurs"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="buyersLabel" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                </HBox>
                <ProgressBar progress="0.60" prefWidth="180" prefHeight="4"
                             style="-fx-accent: #f59e0b; -fx-background-radius: 2;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 60; -fx-background-color: #e2e8f0;"/>

            <!-- Stat 4: Total Dépensé -->
            <VBox spacing="8" alignment="CENTER_LEFT" prefWidth="200">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox alignment="CENTER" spacing="0"
                          style="-fx-background-color: #e0e7ff;
                                 -fx-background-radius: 12;
                                 -fx-padding: 12;">
                        <Label text="💰" style="-fx-font-size: 28px;"/>
                    </VBox>
                    <VBox spacing="2" alignment="CENTER_LEFT">
                        <Label text="Total Dépensé"
                               style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: 600;"/>
                        <Label fx:id="totalRevenueLabel" text="0 DH"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                </HBox>
                <ProgressBar progress="0.85" prefWidth="180" prefHeight="4"
                             style="-fx-accent: #6366f1; -fx-background-radius: 2;"/>
            </VBox>
        </HBox>

        <!-- ============================================ -->
        <!-- BARRE DE RECHERCHE + FILTRES + BOUTONS -->
        <!-- ============================================ -->
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: white;
                     -fx-padding: 20;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

            <!-- Barre de recherche principale -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-pref-width: 350;">
                <Label text="🔍" style="-fx-font-size: 18px;"/>
                <TextField fx:id="searchField"
                           promptText="Rechercher par nom ou email..."
                           style="-fx-pref-width: 300;
                                 -fx-padding: 10;
                                 -fx-background-radius: 8;
                                 -fx-border-color: #cbd5e1;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1.5;
                                 -fx-font-size: 13px;"/>
            </HBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 35;"/>

            <!-- Filtres -->
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Filtrer par:"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                <ComboBox fx:id="filterComboBox"
                          promptText="📊 Statut client"
                          style="-fx-pref-width: 180;
                                -fx-background-radius: 8;
                                -fx-border-radius: 8;"/>
            </VBox>

            <Separator orientation="VERTICAL" style="-fx-pref-height: 35;"/>

            <!-- Tri -->
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="Trier par:"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                <ComboBox fx:id="sortComboBox"
                          promptText="🔢 Trier par"
                          style="-fx-pref-width: 180;
                                -fx-background-radius: 8;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Boutons alignés à droite -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="➕ Nouveau Client"
                        onAction="#addNewClient"
                        style="-fx-background-color: #3b82f6;
                               -fx-text-fill: white;
                               -fx-padding: 12 24;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 8, 0, 0, 2);"/>

                <Button text="🔄 Actualiser"
                        onAction="#refreshClients"
                        style="-fx-background-color: #64748b;
                               -fx-text-fill: white;
                               -fx-padding: 12 24;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>

                <Button text="📤 Exporter"
                        style="-fx-background-color: #0f172a;
                               -fx-text-fill: white;
                               -fx-padding: 12 24;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
            </HBox>
        </HBox>

        <!-- ============================================ -->
        <!-- TABLEAU DES CLIENTS (SANS TÉLÉPHONE/ADRESSE) -->
        <!-- ============================================ -->
        <VBox spacing="15"
              style="-fx-background-color: white;
                     -fx-padding: 25;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

            <!-- En-tête du tableau -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋 Liste des Clients"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text="Total: 0 clients"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
            </HBox>

            <Separator style="-fx-background-color: #e2e8f0;"/>

            <!-- Tableau stylé (colonnes réduites) -->
            <TableView fx:id="clientsTable"
                       style="-fx-background-color: transparent;
                             -fx-border-color: transparent;
                             -fx-table-cell-border-color: #f1f5f9;">
                <columns>
                    <TableColumn text="ID" prefWidth="60" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="id"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="👤 Nom Complet" prefWidth="220">
                        <cellValueFactory>
                            <PropertyValueFactory property="fullName"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="📧 Email" prefWidth="260">
                        <cellValueFactory>
                            <PropertyValueFactory property="email"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="📊 Statut" prefWidth="120" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="statutClient"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="🛒 Nb Ventes" prefWidth="110" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="nbVentes"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="💰 Total Dépensé" prefWidth="140" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="totalDepense"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="📅 Dernier Achat" prefWidth="130" style="-fx-alignment: CENTER;">
                        <cellValueFactory>
                            <PropertyValueFactory property="dernierAchat"/>
                        </cellValueFactory>
                    </TableColumn>

                    <TableColumn text="⚙️ Actions" prefWidth="140" style="-fx-alignment: CENTER;">
                        <!-- Les actions seront ajoutées via le contrôleur -->
                    </TableColumn>
                </columns>

                <placeholder>
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                        <Label text="👤" style="-fx-font-size: 48px; -fx-opacity: 0.5;"/>
                        <Label text="Aucun client trouvé"
                               style="-fx-font-size: 16px; -fx-text-fill: #64748b;"/>
                        <Label text="Ajoutez votre premier client en cliquant sur le bouton ci-dessus"
                               style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- ============================================ -->
        <!-- SECTION INSIGHTS CLIENTS -->
        <!-- ============================================ -->
        <HBox spacing="20">
            <!-- Top 5 Meilleurs Clients -->
            <VBox spacing="15" prefWidth="450"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🏆 Top 5 Meilleurs Clients"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </HBox>

                <Separator style="-fx-background-color: #e2e8f0;"/>

                <ListView fx:id="topClientsList"
                          style="-fx-pref-height: 200;
                                -fx-background-radius: 8;
                                -fx-border-color: #e2e8f0;
                                -fx-border-radius: 8;"/>
            </VBox>

            <!-- Activité récente -->
            <VBox spacing="15" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🔔 Activité Récente"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </HBox>

                <Separator style="-fx-background-color: #e2e8f0;"/>

                <ListView fx:id="recentActivityList"
                          style="-fx-pref-height: 200;
                                -fx-background-radius: 8;
                                -fx-border-color: #e2e8f0;
                                -fx-border-radius: 8;"/>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>