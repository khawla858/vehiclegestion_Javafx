<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.vendeur.controller.AjouterMagasinController"
            fitToWidth="true"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);"
            vbarPolicy="AS_NEEDED">

    <VBox spacing="25" style="-fx-padding: 30; -fx-background-color: transparent;">

        <!-- TITRE -->
        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="🏬 Ajouter un Magasin"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 5, 0.5, 0, 2);"/>
            <Label text="Créez un nouveau magasin avec toutes ses informations"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Section Informations Générales -->
        <VBox spacing="15"
              style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #10b981; -fx-border-radius: 12; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋" style="-fx-font-size: 20px;"/>
                <Label text="Informations Générales"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <Separator style="-fx-background-color: #10b981;"/>

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Nom -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Nom du magasin *" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtNom" promptText="Ex: Auto Elite Maroc"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Catégorie -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Catégorie *" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtCategorie" promptText="Ex: Voitures d'occasion"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Adresse -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Adresse *" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtAdresse" promptText="Ex: 456 Boulevard Zerktouni"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Localisation GPS -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Localisation GPS *" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtLocalisation" promptText="Ex: 33.5731,-7.5898"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Description -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                    <Label text="Description *" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextArea fx:id="txtDescription"
                              promptText="Description complète du magasin, services, spécialités..."
                              prefRowCount="3" wrapText="true"
                              style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>
            </GridPane>
        </VBox>

        <!-- Section Coordonnées -->
        <VBox spacing="15"
              style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #3b82f6; -fx-border-radius: 12; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📞" style="-fx-font-size: 20px;"/>
                <Label text="Coordonnées et Contact"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <Separator style="-fx-background-color: #3b82f6;"/>

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Téléphone -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Téléphone *" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtTelephone" promptText="Ex: +212 6 12 34 56 78"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Email -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Email *" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtEmail" promptText="contact@magasin.ma"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Site Web -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Site Web" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtSiteWeb" promptText="https://www.magasin.ma"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Facebook -->
                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Facebook" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtFacebook" promptText="facebook.com/magasin"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Instagram -->
                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Instagram" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <TextField fx:id="txtInstagram" promptText="magasin"
                               style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                </VBox>
            </GridPane>
        </VBox>

        <!-- Section Horaires -->
        <VBox spacing="15"
              style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #f59e0b; -fx-border-radius: 12; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🕒" style="-fx-font-size: 20px;"/>
                <Label text="Horaires d'Ouverture"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <Label text="Format JSON requis"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-style: italic;"/>

            <Separator style="-fx-background-color: #f59e0b;"/>

            <TextArea fx:id="txtHoraires"
                      promptText='{"Lundi":"09:00-18:00", "Mardi":"09:00-18:00", "Mercredi":"09:00-18:00", "Jeudi":"09:00-18:00", "Vendredi":"09:00-18:00", "Samedi":"09:00-13:00", "Dimanche":"Fermé"}'
                      prefRowCount="5" wrapText="true"
                      style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5; -fx-font-family: 'Courier New';"/>
        </VBox>

        <!-- Section Logo -->
        <VBox spacing="15"
              style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #8b5cf6; -fx-border-radius: 12; -fx-border-width: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📸" style="-fx-font-size: 20px;"/>
                <Label text="Logo du Magasin"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <Separator style="-fx-background-color: #8b5cf6;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="logoField" promptText="Aucun fichier sélectionné" editable="false"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #64748b; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-border-width: 1.5;"/>
                <Button text="📁 Parcourir" onAction="#browseLogo"
                        style="-fx-background-color: linear-gradient(to right, #8b5cf6, #d946ef); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(139, 92, 246, 0.5), 8, 0.5, 0, 2);"/>
            </HBox>

            <VBox fx:id="logoPreviewContainer" spacing="8" alignment="CENTER"
                  style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Aperçu du logo" style="-fx-font-size: 12px; -fx-text-fill: white;"/>
                <ImageView fx:id="logoPreview" fitWidth="150" fitHeight="100" preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"/>
            </VBox>
        </VBox>

        <!-- BOUTONS ET MESSAGE EN BAS -->
        <VBox spacing="10"
              style="-fx-background-color: rgba(30, 41, 59, 0.8); -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-width: 1; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 3);">

            <Label fx:id="messageLabel" wrapText="true" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
            <Label text="* Champs obligatoires"
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-style: italic;"/>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Fermer" onAction="#closeWindow"
                        style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button text="✅ Ajouter le Magasin" onAction="#ajouterMagasin"
                        style="-fx-background-color: linear-gradient(to right, #10b981, #059669); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.5), 8, 0.5, 0, 2);"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>