<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.vendeur.controller.MagasinDetailsController"
            fitToWidth="true"
            style="-fx-background: linear-gradient(to bottom right, #0f172a, #1e293b);
                   -fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <VBox spacing="0" style="-fx-background-color: transparent;">

        <!-- =============================================== -->
        <!-- HEADER AVEC LOGO ET NOM -->
        <!-- =============================================== -->
        <HBox alignment="CENTER_LEFT" spacing="25"
              style="-fx-background-color: rgba(30, 41, 59, 0.95);
                     -fx-padding: 35;
                     -fx-border-width: 0 0 1 0;
                     -fx-border-color: linear-gradient(to right, #334155, #475569, #334155);
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0.5, 0, 3);">

            <!-- Logo -->
            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: rgba(15, 23, 42, 0.8);
                         -fx-padding: 25;
                         -fx-background-radius: 15;
                         -fx-border-color: linear-gradient(135deg, #3b82f6, #8b5cf6);
                         -fx-border-width: 2;
                         -fx-border-radius: 15;
                         -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 10, 0.5, 0, 2);">
                <ImageView fx:id="logoImage" fitHeight="120" fitWidth="120" preserveRatio="true" />
            </VBox>

            <!-- Informations principales -->
            <VBox spacing="12" HBox.hgrow="ALWAYS">

                <Text fx:id="nomMagasin" text="Nom du Magasin"
                      style="-fx-font-size: 36px;
                             -fx-font-weight: bold;
                             -fx-fill: #f1f5f9;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 3, 0.5, 0, 1);"/>

                <Text fx:id="categorieMagasin" text="Catégorie"
                      style="-fx-font-size: 17px; -fx-fill: #94a3b8;"/>

                <!-- Badges -->
                <HBox spacing="15" style="-fx-padding: 12 0 0 0;">

                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(59, 130, 246, 0.15);
                                 -fx-padding: 10 18;
                                 -fx-background-radius: 20;
                                 -fx-border-color: rgba(59, 130, 246, 0.4);
                                 -fx-border-width: 1;
                                 -fx-border-radius: 20;">
                        <FontIcon iconLiteral="fas-map-marker-alt" iconSize="16" iconColor="#3b82f6"/>
                        <Label fx:id="localisationBadge" text="Localisation"
                               style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(16, 185, 129, 0.15);
                                 -fx-padding: 10 18;
                                 -fx-background-radius: 20;
                                 -fx-border-color: rgba(16, 185, 129, 0.4);
                                 -fx-border-width: 1;
                                 -fx-border-radius: 20;">
                        <FontIcon iconLiteral="fas-clock" iconSize="16" iconColor="#10b981"/>
                        <Label text="Ouvert" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    </HBox>

                </HBox>

            </VBox>

            <!-- Boutons d'action -->
            <VBox spacing="15" alignment="TOP_RIGHT">

                <Button text="📞 Contacter"
                        style="-fx-background-color: linear-gradient(to right, #3b82f6, #1e40af);
                               -fx-text-fill: #f1f5f9;
                               -fx-padding: 14 35;
                               -fx-background-radius: 12;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.4), 10, 0.6, 0, 2);"/>

                <Button text="🌐 Visiter le site"
                        style="-fx-background-color: rgba(59, 130, 246, 0.15);
                               -fx-text-fill: #3b82f6;
                               -fx-padding: 14 35;
                               -fx-background-radius: 12;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-border-color: #3b82f6;
                               -fx-border-width: 2;
                               -fx-border-radius: 12;
                               -fx-cursor: hand;"/>

                <Button fx:id="btnVoirVehicules" text="🚗 Voir les véhicules"
                        style="-fx-background-color: linear-gradient(to right, #ec4899, #8b5cf6);
                               -fx-text-fill: #f1f5f9;
                               -fx-padding: 14 35;
                               -fx-background-radius: 12;
                               -fx-font-size: 15px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(236, 72, 153, 0.4), 10, 0.6, 0, 2);"/>

            </VBox>

        </HBox>

        <!-- =============================================== -->
        <!-- CONTENU PRINCIPAL -->
        <!-- =============================================== -->
        <HBox spacing="30" style="-fx-padding: 40 50;">

            <!-- =============================================== -->
            <!-- COLONNE GAUCHE -->
            <!-- =============================================== -->
            <VBox spacing="25" prefWidth="600" HBox.hgrow="ALWAYS">

                <!-- HORAIRES -->
                <VBox spacing="20"
                      style="-fx-background-color: rgba(30, 41, 59, 0.95);
                             -fx-padding: 30;
                             -fx-background-radius: 20;
                             -fx-border-color: linear-gradient(to right, #334155, #475569, #334155);
                             -fx-border-width: 1;
                             -fx-border-radius: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0.5, 0, 3);">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <StackPane style="-fx-background-color: linear-gradient(135deg, #3b82f6, #1e40af);
                                          -fx-background-radius: 12;
                                          -fx-pref-width: 50;
                                          -fx-pref-height: 50;
                                          -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.4), 8, 0.5, 0, 2);">
                            <FontIcon iconLiteral="fas-clock" iconSize="24" iconColor="#f1f5f9"/>
                        </StackPane>
                        <Text text="HORAIRES D'OUVERTURE"
                              style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #f1f5f9;"/>
                    </HBox>

                    <Separator style="-fx-background-color: linear-gradient(to right, #334155, transparent, #334155);"/>

                    <VBox fx:id="horairesContainer" spacing="10" />

                </VBox>

                <!-- DESCRIPTION -->
                <VBox spacing="20"
                      style="-fx-background-color: rgba(30, 41, 59, 0.95);
                             -fx-padding: 30;
                             -fx-background-radius: 20;
                             -fx-border-color: linear-gradient(to right, #334155, #475569, #334155);
                             -fx-border-width: 1;
                             -fx-border-radius: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0.5, 0, 3);">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <StackPane style="-fx-background-color: linear-gradient(135deg, #3b82f6, #1e40af);
                                          -fx-background-radius: 12;
                                          -fx-pref-width: 50;
                                          -fx-pref-height: 50;
                                          -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.4), 8, 0.5, 0, 2);">
                            <FontIcon iconLiteral="fas-info-circle" iconSize="24" iconColor="#f1f5f9"/>
                        </StackPane>
                        <Text text="À PROPOS"
                              style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #f1f5f9;"/>
                    </HBox>

                    <Separator style="-fx-background-color: linear-gradient(to right, #334155, transparent, #334155);"/>

                    <Text fx:id="descriptionMagasin"
                          text="Description du magasin..."
                          wrappingWidth="540"
                          style="-fx-font-size: 15px; -fx-fill: #cbd5e1; -fx-line-spacing: 6px;"/>

                </VBox>

                <!-- CONTACT -->
                <VBox spacing="20"
                      style="-fx-background-color: rgba(30, 41, 59, 0.95);
                             -fx-padding: 30;
                             -fx-background-radius: 20;
                             -fx-border-color: linear-gradient(to right, #334155, #475569, #334155);
                             -fx-border-width: 1;
                             -fx-border-radius: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0.5, 0, 3);">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <StackPane style="-fx-background-color: linear-gradient(135deg, #3b82f6, #1e40af);
                                          -fx-background-radius: 12;
                                          -fx-pref-width: 50;
                                          -fx-pref-height: 50;
                                          -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.4), 8, 0.5, 0, 2);">
                            <FontIcon iconLiteral="fas-phone" iconSize="24" iconColor="#f1f5f9"/>
                        </StackPane>
                        <Text text="COORDONNÉES"
                              style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #f1f5f9;"/>
                    </HBox>

                    <Separator style="-fx-background-color: linear-gradient(to right, #334155, transparent, #334155);"/>

                    <GridPane hgap="18" vgap="16">

                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="0">
                            <FontIcon iconLiteral="fas-map-marker-alt" iconSize="16" iconColor="#3b82f6"/>
                            <Label text="Adresse :"
                                   style="-fx-font-weight: bold; -fx-text-fill: #f1f5f9; -fx-min-width: 120;"/>
                        </HBox>
                        <Label fx:id="adresseMagasin" text="123 Rue Example"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"
                               style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;"/>

                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <FontIcon iconLiteral="fas-phone" iconSize="16" iconColor="#3b82f6"/>
                            <Label text="Téléphone :"
                                   style="-fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                        </HBox>
                        <Label fx:id="telephoneMagasin" text="+212 5 00000000"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"
                               style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;"/>

                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="2" GridPane.columnIndex="0">
                            <FontIcon iconLiteral="fas-envelope" iconSize="16" iconColor="#3b82f6"/>
                            <Label text="Email :"
                                   style="-fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                        </HBox>
                        <Hyperlink fx:id="emailMagasin" text="contact@example.com"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #3b82f6; -fx-font-size: 14px;"/>

                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="0">
                            <FontIcon iconLiteral="fas-globe" iconSize="16" iconColor="#3b82f6"/>
                            <Label text="Site Web :"
                                   style="-fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                        </HBox>
                        <Hyperlink fx:id="lienSiteWeb" text="www.example.com"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #3b82f6; -fx-font-size: 14px;"/>

                    </GridPane>

                </VBox>

                <!-- RÉSEAUX SOCIAUX -->
                <VBox spacing="20"
                      style="-fx-background-color: rgba(30, 41, 59, 0.95);
                             -fx-padding: 30;
                             -fx-background-radius: 20;
                             -fx-border-color: linear-gradient(to right, #334155, #475569, #334155);
                             -fx-border-width: 1;
                             -fx-border-radius: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0.5, 0, 3);">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <StackPane style="-fx-background-color: linear-gradient(135deg, #ec4899, #8b5cf6);
                                          -fx-background-radius: 12;
                                          -fx-pref-width: 50;
                                          -fx-pref-height: 50;
                                          -fx-effect: dropshadow(gaussian, rgba(236, 72, 153, 0.4), 8, 0.5, 0, 2);">
                            <FontIcon iconLiteral="fas-share-alt" iconSize="24" iconColor="#f1f5f9"/>
                        </StackPane>
                        <Text text="SUIVEZ-NOUS"
                              style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #f1f5f9;"/>
                    </HBox>

                    <Separator style="-fx-background-color: linear-gradient(to right, #334155, transparent, #334155);"/>

                    <HBox spacing="15">
                        <Button fx:id="btnFacebook" text="f Facebook"
                                style="-fx-background-color: #1877f2;
                                       -fx-text-fill: #f1f5f9;
                                       -fx-padding: 12 25;
                                       -fx-background-radius: 10;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(24, 119, 242, 0.3), 8, 0.5, 0, 2);"/>

                        <Button fx:id="btnInstagram" text="📷 Instagram"
                                style="-fx-background-color: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
                                       -fx-text-fill: #f1f5f9;
                                       -fx-padding: 12 25;
                                       -fx-background-radius: 10;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(240, 148, 51, 0.3), 8, 0.5, 0, 2);"/>
                    </HBox>

                </VBox>

            </VBox>

            <!-- =============================================== -->
            <!-- COLONNE DROITE : CARTE -->
            <!-- =============================================== -->
            <VBox spacing="20" prefWidth="450">

                <VBox spacing="20"
                      style="-fx-background-color: rgba(30, 41, 59, 0.95);
                             -fx-padding: 30;
                             -fx-background-radius: 20;
                             -fx-border-color: linear-gradient(to right, #334155, #475569, #334155);
                             -fx-border-width: 1;
                             -fx-border-radius: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0.5, 0, 3);">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <StackPane style="-fx-background-color: linear-gradient(135deg, #10b981, #059669);
                                          -fx-background-radius: 12;
                                          -fx-pref-width: 50;
                                          -fx-pref-height: 50;
                                          -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.4), 8, 0.5, 0, 2);">
                            <FontIcon iconLiteral="fas-map-marked-alt" iconSize="24" iconColor="#f1f5f9"/>
                        </StackPane>
                        <Text text="LOCALISATION"
                              style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #f1f5f9;"/>
                    </HBox>

                    <Separator style="-fx-background-color: linear-gradient(to right, #334155, transparent, #334155);"/>

                    <!-- Carte (ImageView) -->
                    <StackPane style="-fx-background-color: rgba(15, 23, 42, 0.6);
                                      -fx-background-radius: 12;
                                      -fx-border-color: #475569;
                                      -fx-border-width: 2;
                                      -fx-border-radius: 12;">

                        <ImageView fx:id="carteImage"
                                   fitWidth="400"
                                   fitHeight="500"
                                   preserveRatio="false"
                                   pickOnBounds="true"
                                   style="-fx-opacity: 0.9;"/>

                        <VBox alignment="BOTTOM_CENTER" style="-fx-padding: 15;">
                            <Button fx:id="btnVoirCarte" text="🔍 Voir en plein écran"
                                    style="-fx-background-color: rgba(59, 130, 246, 0.9);
                                           -fx-text-fill: #f1f5f9;
                                           -fx-padding: 10 20;
                                           -fx-background-radius: 10;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.4), 8, 0.5, 0, 2);"/>
                        </VBox>

                    </StackPane>

                    <!-- Indications -->
                    <VBox spacing="15" style="-fx-padding: 10 0 0 0;">

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: rgba(16, 185, 129, 0.2);
                                              -fx-background-radius: 8;
                                              -fx-pref-width: 32;
                                              -fx-pref-height: 32;">
                                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="16" iconColor="#10b981"/>
                            </StackPane>
                            <Label fx:id="etageInfo" text="Situé au deuxième étage"
                                   style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;"/>
                        </HBox>

                        <Button fx:id="btnItineraire"
                                text="🧭 Obtenir l'itinéraire"
                                style="-fx-background-color: linear-gradient(to right, #10b981, #059669);
                                       -fx-text-fill: #f1f5f9;
                                       -fx-padding: 14 0;
                                       -fx-background-radius: 12;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-pref-width: 400;
                                       -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.4), 10, 0.6, 0, 2);">
                            <tooltip>
                                <Tooltip text="Ouvrir l'itinéraire dans Google Maps"/>
                            </tooltip>
                        </Button>

                        <Label text="💡 Cliquez sur le bouton pour ouvrir Google Maps"
                               style="-fx-text-fill: #94a3b8;
                                      -fx-font-size: 13px;
                                      -fx-font-style: italic;"/>

                    </VBox>

                </VBox>

            </VBox>

        </HBox>

    </VBox>

</ScrollPane>