<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.vendeur.controller.MagasinDetailsController"
            fitToWidth="true"
            style="-fx-background-color: white;">

    <VBox spacing="0" style="-fx-background-color: transparent;">

        <!-- HEADER AVEC LOGO ET NOM -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="
                     -fx-padding: 30;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0.5, 0, 5);">

            <!-- Logo -->
            <VBox alignment="CENTER" spacing="10"
                  style="

                         -fx-background-radius: 12;
                         -fx-border-color: linear-gradient(to right, #3b82f6, #8b5cf6);
                         -fx-border-width: 2;
                         -fx-border-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 10, 0.5, 0, 3);">
                <ImageView fx:id="logoImage" fitHeight="145" fitWidth="146" preserveRatio="true" />
            </VBox>

            <!-- Informations principales -->
            <VBox spacing="8" HBox.hgrow="ALWAYS">

                <Text fx:id="nomMagasin" text="Nom du Magasin"
                      style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: rgba(30, 41, 59, 0.9);
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 5, 0.5, 0, 2);"/>

                <Text fx:id="categorieMagasin" text="Catégorie"
                      style="-fx-font-size: 16px; -fx-fill: rgba(30, 41, 59, 0.9);"/>

                <!-- Badges -->
                <HBox spacing="15" style="-fx-padding: 10 0 0 0;">

                    <HBox spacing="8" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(59, 130, 246, 0.2);
                                 -fx-padding: 8 15;
                                 -fx-background-radius: 20;
                                 -fx-border-color: #3b82f6;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 20;">
                        <FontIcon iconLiteral="fas-map-marker-alt" iconSize="14" iconColor="#3b82f6"/>
                        <Label fx:id="localisationBadge" text="Localisation"
                               style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    </HBox>

                    <HBox spacing="8" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(16, 185, 129, 0.2);
                                 -fx-padding: 8 15;
                                 -fx-background-radius: 20;
                                 -fx-border-color: #10b981;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 20;">
                        <FontIcon iconLiteral="fas-clock" iconSize="14" iconColor="#10b981"/>
                        <Label text="Ouvert" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    </HBox>

                </HBox>

            </VBox>

            <!-- Boutons d'action -->
            <VBox spacing="12" alignment="TOP_RIGHT">

                <Button style="-fx-background-color: linear-gradient(to right, #3b82f6, #8b5cf6);
                               -fx-text-fill: white; -fx-padding: 12 30; -fx-background-radius: 8;
                               -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.5), 10, 0.5, 0, 3);">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <FontIcon iconLiteral="fas-phone" iconSize="14" iconColor="white"/>
                            <Label text="Contacter" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button style="-fx-background-color: linear-gradient(to right, #3b82f6, #8b5cf6);
                               -fx-text-fill: white; -fx-padding: 12 30;
                               -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-border-color: #475569; -fx-border-width: 1; -fx-border-radius: 8;
                               -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <FontIcon iconLiteral="fas-globe" iconSize="14" iconColor="white"/>
                            <Label text="Visiter le site" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>

                <HBox spacing="15" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnVoirVehicules"
                            style="-fx-background-color: linear-gradient(to right, #3b82f6, #8b5cf6);
                                   -fx-text-fill: white; -fx-padding: 12 30;
                                   -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-border-color: #8b5cf6; -fx-border-width: 2; -fx-border-radius: 8;
                                   -fx-cursor: hand;">
                        <graphic>
                            <HBox spacing="8" alignment="CENTER">
                                <FontIcon iconLiteral="fas-car" iconSize="14" iconColor="#8b5cf6"/>
                                <Label text="Voir les véhicules"
                                       style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>

            </VBox>

        </HBox>

        <!-- CONTENU PRINCIPAL -->
        <HBox spacing="25" style="-fx-padding: 30;">

            <!-- COLONNE GAUCHE -->
            <VBox spacing="20" prefWidth="600" HBox.hgrow="ALWAYS">

                <!-- Horaires -->
                <VBox spacing="15"
                      style="-fx-background-color: rgba(30, 41, 59, 0.9);
                             -fx-padding: 25;
                             -fx-background-radius: 12;
                             -fx-border-color: #334155;
                             -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="fas-clock" iconSize="20" iconColor="#3b82f6"/>
                        <Text text="HORAIRES D'OUVERTURE"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: white;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #475569;"/>

                    <VBox fx:id="horairesContainer" spacing="10" />

                </VBox>

                <!-- Description -->
                <VBox spacing="15"
                      style="-fx-background-color: rgba(30, 41, 59, 0.9);
                             -fx-padding: 25;
                             -fx-background-radius: 12;
                             -fx-border-color: #334155;
                             -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="fas-info-circle" iconSize="20" iconColor="#3b82f6"/>
                        <Text text="À PROPOS"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: white;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #475569;"/>

                    <Text fx:id="descriptionMagasin"
                          text="Description du magasin..."
                          wrappingWidth="540"
                          style="-fx-font-size: 14px; -fx-fill: #cbd5e1; -fx-line-spacing: 5px;"/>

                </VBox>

                <!-- Contact -->
                <VBox spacing="15"
                      style="-fx-background-color: rgba(30, 41, 59, 0.9);
                             -fx-padding: 25;
                             -fx-background-radius: 12;
                             -fx-border-color: #334155;
                             -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="fas-address-card" iconSize="20" iconColor="#3b82f6"/>
                        <Text text="COORDONNÉES"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: white;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #475569;"/>

                    <GridPane hgap="15" vgap="12">

                        <Label GridPane.rowIndex="0" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #94a3b8; -fx-min-width: 120;">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <FontIcon iconLiteral="fas-map-marker-alt" iconSize="14" iconColor="#94a3b8"/>
                                    <Label text="Adresse :" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Label>
                        <Label fx:id="adresseMagasin" text="123 Rue Example"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"
                               style="-fx-text-fill: white;"/>

                        <Label GridPane.rowIndex="1" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #94a3b8;">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <FontIcon iconLiteral="fas-phone" iconSize="14" iconColor="#94a3b8"/>
                                    <Label text="Téléphone :" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Label>
                        <Label fx:id="telephoneMagasin" text="+212 5 00000000"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"
                               style="-fx-text-fill: white;"/>

                        <Label GridPane.rowIndex="2" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #94a3b8;">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <FontIcon iconLiteral="fas-envelope" iconSize="14" iconColor="#94a3b8"/>
                                    <Label text="Email :" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Label>
                        <Hyperlink fx:id="emailMagasin" text="contact@example.com"
                                   GridPane.rowIndex="2" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #3b82f6;"/>

                        <Label GridPane.rowIndex="3" GridPane.columnIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #94a3b8;">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <FontIcon iconLiteral="fas-globe" iconSize="14" iconColor="#94a3b8"/>
                                    <Label text="Site Web :" style="-fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Label>
                        <Hyperlink fx:id="lienSiteWeb" text="www.example.com"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"
                                   style="-fx-text-fill: #3b82f6;"/>

                    </GridPane>

                </VBox>

                <!-- Réseaux sociaux -->
                <VBox spacing="15"
                      style="-fx-background-color: rgba(30, 41, 59, 0.9);
                             -fx-padding: 25;
                             -fx-background-radius: 12;
                             -fx-border-color: #334155;
                             -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="fas-share-alt" iconSize="20" iconColor="#3b82f6"/>
                        <Text text="SUIVEZ-NOUS"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: white;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #475569;"/>

                    <HBox spacing="15">
                        <Button fx:id="btnFacebook"
                                style="-fx-background-color: #1877f2;
                                       -fx-text-fill: white;
                                       -fx-padding: 10 20;
                                       -fx-background-radius: 8;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(24, 119, 242, 0.3), 8, 0.5, 0, 2);">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER">
                                    <FontIcon iconLiteral="fab-facebook-f" iconSize="14" iconColor="white"/>
                                    <Label text="Facebook" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>

                        <Button fx:id="btnInstagram"
                                style="-fx-background-color: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
                                       -fx-text-fill: white;
                                       -fx-padding: 10 20;
                                       -fx-background-radius: 8;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(188, 24, 136, 0.3), 8, 0.5, 0, 2);">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER">
                                    <FontIcon iconLiteral="fab-instagram" iconSize="14" iconColor="white"/>
                                    <Label text="Instagram" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>
                    </HBox>

                </VBox>

            </VBox>

            <!-- COLONNE DROITE : CARTE -->
            <VBox spacing="20" prefWidth="450">

                <VBox spacing="15"
                      style="-fx-background-color: rgba(30, 41, 59, 0.9);
                             -fx-padding: 25;
                             -fx-background-radius: 12;
                             -fx-border-color: #334155;
                             -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="fas-map" iconSize="20" iconColor="#3b82f6"/>
                        <Text text="LOCALISATION"
                              style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: white;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #475569;"/>

                    <!-- Carte (ImageView) -->
                    <StackPane
                            style="-fx-background-color: rgba(15, 23, 42, 0.5);
                                   -fx-background-radius: 8;
                                   -fx-border-color: #475569;
                                   -fx-border-width: 2;
                                   -fx-border-radius: 8;">

                        <ImageView fx:id="carteImage"
                                   fitWidth="400"
                                   fitHeight="500"
                                   preserveRatio="false"
                                   pickOnBounds="true"/>

                        <VBox alignment="BOTTOM_CENTER" style="-fx-padding: 10;">
                            <Button fx:id="btnVoirCarte"
                                    style="-fx-background-color: rgba(30, 41, 59, 0.95);
                                           -fx-text-fill: white;
                                           -fx-padding: 8 16;
                                           -fx-background-radius: 6;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;
                                           -fx-border-color: #3b82f6;
                                           -fx-border-width: 1;
                                           -fx-border-radius: 6;
                                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);">
                                <graphic>
                                    <HBox spacing="8" alignment="CENTER">
                                        <FontIcon iconLiteral="fas-search-plus" iconSize="12" iconColor="white"/>
                                        <Label text="Voir en plein écran"
                                               style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                    </HBox>
                                </graphic>
                            </Button>
                        </VBox>

                    </StackPane>

                    <!-- Indications -->
                    <VBox spacing="10" style="-fx-padding: 10 0 0 0;">

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-info-circle" iconSize="16" iconColor="#94a3b8"/>
                            <Label fx:id="etageInfo" text="Situé au deuxième étage"
                                   style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;"/>
                        </HBox>

                        <Button fx:id="btnItineraire"
                                text=""
                                style="-fx-background-color: linear-gradient(to right, #10b981, #059669);
                                       -fx-text-fill: white;
                                       -fx-padding: 12 0;
                                       -fx-background-radius: 8;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-pref-width: 400;
                                       -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.3), 8, 0, 0, 2);">
                            <graphic>
                                <HBox spacing="10" alignment="CENTER">
                                    <FontIcon iconLiteral="fas-directions" iconSize="16" iconColor="white"/>
                                    <Label text="Obtenir l'itinéraire"
                                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Ouvrir l'itinéraire dans Google Maps"/>
                            </tooltip>
                        </Button>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fas-lightbulb" iconSize="12" iconColor="#64748b"/>
                            <Label text="Cliquez sur le bouton pour ouvrir Google Maps"
                                   style="-fx-text-fill: #64748b; -fx-font-size: 12px; -fx-font-style: italic;"/>
                        </HBox>

                    </VBox>

                </VBox>

            </VBox>

        </HBox>

    </VBox>

</ScrollPane>