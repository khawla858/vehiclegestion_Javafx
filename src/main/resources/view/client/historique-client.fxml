<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.client.controller.HistoriqueController"
            fx:id="mainContainer"
            style="-fx-background-color: #0f172a;">

    <top>
        <VBox style="-fx-background-color: rgba(15, 23, 42, 0.95); -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
            <!-- En-tête principal STYLE MODERNE -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 15 20;">
                <VBox spacing="2">
                    <Label text="📋 Mon Historique" style="-fx-font-size: 20px; -fx-font-weight: bold;
                           -fx-text-fill: linear-gradient(to right, #ec4899, #8b5cf6);"/>
                    <Label text="Vos activités passées" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Boutons d'action COMPACTES -->
                <HBox spacing="6" alignment="CENTER_RIGHT">
                    <Button fx:id="btnExport" text="📤 Exporter"
                            style="-fx-background-color: linear-gradient(to right, #10b981, #059669);
                                   -fx-text-fill: white; -fx-background-radius: 6; -fx-min-height: 32;
                                   -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 6 12;
                                   -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.3), 4, 0.5, 0, 1);"/>
                    <Button fx:id="btnRefresh" text="🔄"
                            style="-fx-background-color: linear-gradient(to right, #3b82f6, #1d4ed8);
                                   -fx-text-fill: white; -fx-background-radius: 6; -fx-min-height: 32;
                                   -fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 6 12;
                                   -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 4, 0.5, 0, 1);"/>
                </HBox>
            </HBox>

            <!-- Barre de filtres et recherche COMPACTE -->
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 0 20 10 20;">
                <!-- Filtre Période -->
                <VBox spacing="1">
                    <Label text="Période" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-font-weight: 500;"/>
                    <ComboBox fx:id="periodeCombo" prefWidth="100" prefHeight="30"
                              style="-fx-background-color: rgba(30, 41, 59, 0.8);
                                     -fx-background-radius: 4;
                                     -fx-border-color: #475569;
                                     -fx-border-width: 1;
                                     -fx-border-radius: 4;
                                     -fx-text-fill: #f1f5f9;
                                     -fx-font-size: 12px;"/>
                </VBox>

                <!-- Filtre Type -->
                <VBox spacing="1">
                    <Label text="Type" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-font-weight: 500;"/>
                    <ComboBox fx:id="typeCombo" prefWidth="100" prefHeight="30"
                              style="-fx-background-color: rgba(30, 41, 59, 0.8);
                                     -fx-background-radius: 4;
                                     -fx-border-color: #475569;
                                     -fx-border-width: 1;
                                     -fx-border-radius: 4;
                                     -fx-text-fill: #f1f5f9;
                                     -fx-font-size: 12px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Recherche COMPACTE -->
                <VBox spacing="1">
                    <Label text="Recherche" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-font-weight: 500;"/>
                    <HBox spacing="0" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(30, 41, 59, 0.8);
                                 -fx-background-radius: 4;
                                 -fx-border-color: #475569;
                                 -fx-border-width: 1;
                                 -fx-border-radius: 4;
                                 -fx-padding: 0 8;">
                        <Label text="🔍" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                        <TextField fx:id="searchField"
                                   promptText="Rechercher..."
                                   style="-fx-background-color: transparent;
                                          -fx-border-width: 0;
                                          -fx-pref-width: 120;
                                          -fx-pref-height: 28;
                                          -fx-padding: 0 8;
                                          -fx-font-size: 12px;
                                          -fx-text-fill: #f1f5f9;
                                          -fx-prompt-text-fill: #64748b;"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Cartes statistiques COMPACTES EN 1 LIGNE -->
            <HBox spacing="6" style="-fx-padding: 0 20 15 20;" alignment="CENTER">
                <!-- Carte Total Actions -->
                <VBox spacing="0"
                      style="-fx-background-color: rgba(30, 41, 59, 0.8);
                             -fx-border-color: linear-gradient(to right, #3b82f6, #8b5cf6);
                             -fx-border-width: 1;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-padding: 6;
                             -fx-pref-width: 70;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.5, 0, 1);">
                    <Label text="📊 Total" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: 500;"/>
                    <Label fx:id="lblTotalActions" text="0"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: linear-gradient(to right, #ec4899, #8b5cf6);"/>
                </VBox>

                <!-- Carte Rendez-vous -->
                <VBox spacing="0"
                      style="-fx-background-color: rgba(30, 41, 59, 0.8);
                             -fx-border-color: #3b82f6;
                             -fx-border-width: 1;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-padding: 6;
                             -fx-pref-width: 70;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.5, 0, 1);">
                    <Label text="📅 RDV" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: 500;"/>
                    <Label fx:id="lblTotalRDV" text="0"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                </VBox>

                <!-- Carte Transactions -->
                <VBox spacing="0"
                      style="-fx-background-color: rgba(30, 41, 59, 0.8);
                             -fx-border-color: #10b981;
                             -fx-border-width: 1;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-padding: 6;
                             -fx-pref-width: 70;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.5, 0, 1);">
                    <Label text="💰 Achats" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: 500;"/>
                    <Label fx:id="lblTotalVentes" text="0"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                </VBox>

                <!-- Carte Avis -->
                <VBox spacing="0"
                      style="-fx-background-color: rgba(30, 41, 59, 0.8);
                             -fx-border-color: #f59e0b;
                             -fx-border-width: 1;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-padding: 6;
                             -fx-pref-width: 70;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.5, 0, 1);">
                    <Label text="⭐ Avis" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: 500;"/>
                    <Label fx:id="lblTotalAvis" text="0"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                </VBox>

                <!-- Carte Dépenses -->
                <VBox spacing="0"
                      style="-fx-background-color: rgba(30, 41, 59, 0.8);
                             -fx-border-color: #ef4444;
                             -fx-border-width: 1;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-padding: 6;
                             -fx-pref-width: 80;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.5, 0, 1);">
                    <Label text="💳 Dépensé" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: 500;"/>
                    <Label fx:id="lblTotalDepense" text="0€"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                  -fx-text-fill: linear-gradient(to right, #ef4444, #dc2626);"/>
                </VBox>

                <!-- Carte Notes moyennes -->
                <VBox spacing="0"
                      style="-fx-background-color: rgba(30, 41, 59, 0.8);
                             -fx-border-color: #8b5cf6;
                             -fx-border-width: 1;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-padding: 6;
                             -fx-pref-width: 80;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.5, 0, 1);">
                    <Label text="📊 Moyenne" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: 500;"/>
                    <Label fx:id="lblMoyenneNotes" text="0/5"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                  -fx-text-fill: linear-gradient(to right, #8b5cf6, #7c3aed);"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane style="-fx-background-color: #0f172a;">

            <!-- Section tableau PRINCIPALE (prend tout l'espace quand visible) -->
            <VBox fx:id="tableSection" spacing="0" visible="false" managed="false"
                  style="-fx-background-color: rgba(15, 23, 42, 0.95);"
                  StackPane.alignment="TOP_LEFT">

                <!-- En-tête du tableau COMPACT -->
                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(15, 23, 42, 0.95);
                             -fx-border-color: #334155; -fx-border-width: 0 0 1 0; -fx-padding: 12 20;">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="tableTitle" text="📅 DÉTAILS DES RENDEZ-VOUS"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;
                                      -fx-text-fill: linear-gradient(to right, #ec4899, #8b5cf6);"/>
                        <Label fx:id="tableSubtitle" text="Liste complète de tous vos rendez-vous"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
                    </VBox>

                    <Label fx:id="tableCount" text="0 rendez-vous"
                           style="-fx-background-color: rgba(59, 130, 246, 0.1);
                                  -fx-text-fill: #3b82f6; -fx-padding: 4 10;
                                  -fx-background-radius: 12; -fx-font-weight: bold;
                                  -fx-font-size: 11px; -fx-border-color: #3b82f6;
                                  -fx-border-width: 1; -fx-border-radius: 12;"/>

                    <Button fx:id="btnHideTable" text="×"
                            style="-fx-background-color: rgba(239, 68, 68, 0.1);
                                   -fx-text-fill: #ef4444; -fx-border-color: rgba(239, 68, 68, 0.3);
                                   -fx-border-width: 1; -fx-border-radius: 4; -fx-padding: 4 8;
                                   -fx-font-size: 11px; -fx-font-weight: 500;
                                   -fx-cursor: hand; -fx-min-width: 30;"/>
                </HBox>

                <!-- Tableau PRINCIPAL (prend tout l'espace restant) -->
                <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 15;">

                    <!-- Tableau des Rendez-vous - COLONNES RÉDUITES -->
                    <TableView fx:id="rdvTableView" visible="false" managed="false"
                               VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 12px;
                                      -fx-table-cell-border-color: transparent;
                                      -fx-background-color: rgba(30, 41, 59, 0.8);
                                      -fx-background-radius: 6;
                                      -fx-border-color: #475569;
                                      -fx-border-width: 1;
                                      -fx-border-radius: 6;">
                        <columns>
                            <!-- Largeurs réduites pour optimiser l'espace -->
                            <TableColumn fx:id="rdvDateCol" text="Date" prefWidth="90" minWidth="70"/>
                            <TableColumn fx:id="rdvHeureCol" text="Heure" prefWidth="70" minWidth="50"/>
                            <TableColumn fx:id="rdvArticleCol" text="Article" prefWidth="150" minWidth="100"/>
                            <TableColumn fx:id="rdvVendeurCol" text="Vendeur" prefWidth="120" minWidth="80"/>
                            <TableColumn fx:id="rdvStatutCol" text="Statut" prefWidth="90" minWidth="70"/>
                            <TableColumn fx:id="rdvNotesCol" text="Notes" prefWidth="200" minWidth="150"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Tableau des Ventes - COLONNES RÉDUITES -->
                    <TableView fx:id="ventesTableView" visible="false" managed="false"
                               VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 12px;
                                      -fx-table-cell-border-color: transparent;
                                      -fx-background-color: rgba(30, 41, 59, 0.8);
                                      -fx-background-radius: 6;
                                      -fx-border-color: #475569;
                                      -fx-border-width: 1;
                                      -fx-border-radius: 6;">
                        <columns>
                            <TableColumn fx:id="venteDateCol" text="Date" prefWidth="90" minWidth="70"/>
                            <TableColumn fx:id="venteArticleCol" text="Article" prefWidth="150" minWidth="100"/>
                            <TableColumn fx:id="venteMontantCol" text="Montant" prefWidth="100" minWidth="70"/>
                            <TableColumn fx:id="venteStatutCol" text="Statut" prefWidth="90" minWidth="70"/>
                            <TableColumn fx:id="ventePaiementCol" text="Paiement" prefWidth="100" minWidth="70"/>
                            <TableColumn fx:id="venteDetailsCol" text="Détails" prefWidth="120" minWidth="80"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Tableau des Commentaires - COLONNES RÉDUITES -->
                    <TableView fx:id="commentairesTableView" visible="false" managed="false"
                               VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 12px;
                                      -fx-table-cell-border-color: transparent;
                                      -fx-background-color: rgba(30, 41, 59, 0.8);
                                      -fx-background-radius: 6;
                                      -fx-border-color: #475569;
                                      -fx-border-width: 1;
                                      -fx-border-radius: 6;">
                        <columns>
                            <TableColumn fx:id="comDateCol" text="Date" prefWidth="90" minWidth="70"/>
                            <TableColumn fx:id="comArticleCol" text="Article" prefWidth="150" minWidth="100"/>
                            <TableColumn fx:id="comNoteCol" text="Note" prefWidth="70" minWidth="50"/>
                            <TableColumn fx:id="comTitreCol" text="Titre" prefWidth="120" minWidth="80"/>
                            <TableColumn fx:id="comTexteCol" text="Commentaire" prefWidth="200" minWidth="150"/>
                            <TableColumn fx:id="comStatutCol" text="Statut" prefWidth="90" minWidth="70"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                </VBox>
            </VBox>

            <!-- Historique principal (MASQUÉ quand tableau visible) -->
            <VBox fx:id="historiqueContent" spacing="0" StackPane.alignment="TOP_LEFT">
                <ScrollPane fx:id="scrollContainer" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-border-width: 0;"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="historiqueContainer" spacing="12" style="-fx-padding: 20;"/>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>

</BorderPane>