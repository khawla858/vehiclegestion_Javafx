<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.client.controller.HistoriqueController"
            fx:id="mainContainer"
            style="-fx-background-color: #f8f9fa;">

    <top>
        <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <!-- En-tête principal COMPACT -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 12 20;">
                <VBox spacing="2">
                    <Label text="📋 Mon Historique" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Vos activités passées" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Boutons d'action COMPACTS -->
                <HBox spacing="6" alignment="CENTER_RIGHT">
                    <Button fx:id="btnExport" text="📤 Exporter"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 4; -fx-min-height: 28; -fx-font-size: 12px;"/>
                    <Button fx:id="btnRefresh" text="🔄 Actualiser"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4; -fx-min-height: 28; -fx-font-size: 12px;"/>
                </HBox>
            </HBox>

            <!-- Barre de filtres et recherche COMPACTE -->
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 0 20 10 20;">
                <!-- Filtre Période -->
                <VBox spacing="1">
                    <Label text="Période" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <ComboBox fx:id="periodeCombo" prefWidth="110" prefHeight="28"/>
                </VBox>

                <!-- Filtre Type -->
                <VBox spacing="1">
                    <Label text="Type" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <ComboBox fx:id="typeCombo" prefWidth="110" prefHeight="28"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Recherche COMPACTE -->
                <VBox spacing="1">
                    <Label text="Recherche" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <TextField fx:id="searchField" prefWidth="160" prefHeight="28" promptText="Rechercher..."/>
                </VBox>
            </HBox>

            <!-- Cartes statistiques COMPACTES EN 1 LIGNE -->
            <HBox spacing="6" style="-fx-padding: 0 20 12 20;" alignment="CENTER">
                <!-- Carte Total Actions -->
                <VBox spacing="1" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-pref-width: 80;">
                    <Label text="📊 Total" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <Label fx:id="lblTotalActions" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                </VBox>

                <!-- Carte Rendez-vous -->
                <VBox spacing="1" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-pref-width: 80;">
                    <Label text="📅 RDV" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <Label fx:id="lblTotalRDV" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                </VBox>

                <!-- Carte Transactions -->
                <VBox spacing="1" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-pref-width: 80;">
                    <Label text="💰 Achats" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <Label fx:id="lblTotalVentes" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                </VBox>

                <!-- Carte Avis -->
                <VBox spacing="1" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-pref-width: 80;">
                    <Label text="⭐ Avis" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <Label fx:id="lblTotalAvis" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                </VBox>

                <!-- Carte Dépenses -->
                <VBox spacing="1" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-pref-width: 90;">
                    <Label text="💳 Dépensé" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <Label fx:id="lblTotalDepense" text="0€" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                </VBox>

                <!-- Carte Notes moyennes -->
                <VBox spacing="1" style="-fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6; -fx-pref-width: 90;">
                    <Label text="📊 Moyenne" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;"/>
                    <Label fx:id="lblMoyenneNotes" text="0/5" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane style="-fx-background-color: #f8f9fa;">

            <!-- Section tableau PRINCIPALE (prend tout l'espace quand visible) -->
            <VBox fx:id="tableSection" spacing="0" visible="false" managed="false"
                  style="-fx-background-color: white;"
                  StackPane.alignment="TOP_LEFT">

                <!-- En-tête du tableau -->
                <HBox spacing="15" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0; -fx-padding: 15 20;">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="tableTitle" text="📅 DÉTAILS DES RENDEZ-VOUS"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label fx:id="tableSubtitle" text="Liste complète de tous vos rendez-vous"
                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                    </VBox>

                    <Label fx:id="tableCount" text="0 rendez-vous"
                           style="-fx-background-color: #3498db20; -fx-text-fill: #3498db; -fx-padding: 6 12; -fx-background-radius: 16; -fx-font-weight: bold; -fx-font-size: 12px;"/>

                    <Button fx:id="btnHideTable" text="× Fermer"
                            style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 4; -fx-padding: 4 10; -fx-font-size: 11px;"
                            />
                </HBox>

                <!-- Tableau PRINCIPAL (prend tout l'espace restant) -->
                <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 15;">

                    <!-- Tableau des Rendez-vous -->
                    <TableView fx:id="rdvTableView" visible="false" managed="false"
                               VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 14px; -fx-table-cell-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="rdvDateCol" text="Date" prefWidth="100" minWidth="80"/>
                            <TableColumn fx:id="rdvHeureCol" text="Heure" prefWidth="80" minWidth="60"/>
                            <TableColumn fx:id="rdvArticleCol" text="Article" prefWidth="200" minWidth="150"/>
                            <TableColumn fx:id="rdvVendeurCol" text="Vendeur" prefWidth="150" minWidth="120"/>
                            <TableColumn fx:id="rdvStatutCol" text="Statut" prefWidth="100" minWidth="80"/>
                            <TableColumn fx:id="rdvNotesCol" text="Notes" prefWidth="300" minWidth="200"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Tableau des Ventes -->
                    <TableView fx:id="ventesTableView" visible="false" managed="false"
                               VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 14px; -fx-table-cell-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="venteDateCol" text="Date" prefWidth="100" minWidth="80"/>
                            <TableColumn fx:id="venteArticleCol" text="Article" prefWidth="200" minWidth="150"/>
                            <TableColumn fx:id="venteMontantCol" text="Montant" prefWidth="120" minWidth="80"/>
                            <TableColumn fx:id="venteStatutCol" text="Statut" prefWidth="100" minWidth="80"/>
                            <TableColumn fx:id="ventePaiementCol" text="Méthode" prefWidth="120" minWidth="80"/>
                            <TableColumn fx:id="venteDetailsCol" text="Détails" prefWidth="150" minWidth="100"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Tableau des Commentaires -->
                    <TableView fx:id="commentairesTableView" visible="false" managed="false"
                               VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 14px; -fx-table-cell-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="comDateCol" text="Date" prefWidth="100" minWidth="80"/>
                            <TableColumn fx:id="comArticleCol" text="Article" prefWidth="200" minWidth="150"/>
                            <TableColumn fx:id="comNoteCol" text="Note" prefWidth="80" minWidth="60"/>
                            <TableColumn fx:id="comTitreCol" text="Titre" prefWidth="150" minWidth="100"/>
                            <TableColumn fx:id="comTexteCol" text="Commentaire" prefWidth="300" minWidth="200"/>
                            <TableColumn fx:id="comStatutCol" text="Statut" prefWidth="100" minWidth="80"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                </VBox>
            </VBox>

            <!-- Historique principal (MASQUÉ quand tableau visible) -->
            <VBox fx:id="historiqueContent" spacing="0" StackPane.alignment="TOP_LEFT">
                <ScrollPane fx:id="scrollContainer" fitToWidth="true"
                            style="-fx-background-color: transparent;"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="historiqueContainer" spacing="15" style="-fx-padding: 20;"/>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>

</BorderPane>