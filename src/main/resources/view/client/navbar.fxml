<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx/"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.vehiclegestion.client.controller.PublicMainController"
          >

    <!-- CONTENU PRINCIPAL -->
    <BorderPane fx:id="mainBorderPane">

        <top>
            <VBox spacing="0" style="-fx-background-color: rgba(15, 23, 42, 0.95);">

                <!-- NIVEAU 1 : HEADER PRINCIPAL -->
                <HBox spacing="0" alignment="CENTER"
                      style="-fx-padding: 15 40;
                             -fx-background-color: transparent;
                             -fx-border-width: 0 0 1 0;
                             -fx-border-color: linear-gradient(to right, #334155, #475569, #334155);">

                    <!-- LOGO -->
                    <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <StackPane style="-fx-background-color: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
                                          -fx-background-radius: 10;
                                          -fx-pref-width: 44;
                                          -fx-pref-height: 44;
                                          -fx-effect: dropshadow(gaussian, rgba(236, 72, 153, 0.4), 10, 0.5, 0, 2);">
                            <FontIcon iconLiteral="fas-car-side" iconSize="22" iconColor="white"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="AutoSales Pro"
                                   style="-fx-font-size: 24px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #f1f5f9;
                                          -fx-font-family: 'Segoe UI', 'Arial', sans-serif;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 2, 0.5, 0, 1);"/>
                            <Label text="Premium Vehicle Marketplace"
                                   style="-fx-font-size: 11px;
                                          -fx-text-fill: #94a3b8;
                                          -fx-font-family: 'Segoe UI', 'Arial', sans-serif;"/>
                        </VBox>
                    </HBox>

                    <!-- BARRE DE RECHERCHE CENTRALE -->
                    <HBox spacing="0" alignment="CENTER"
                          style="-fx-background-color: rgba(30, 41, 59, 0.8);
                                 -fx-background-radius: 25;
                                 -fx-border-color: linear-gradient(to right, #3b82f6, #8b5cf6);
                                 -fx-border-width: 1;
                                 -fx-border-radius: 25;
                                 -fx-padding: 10 20;
                                 -fx-min-width: 500;
                                 -fx-max-width: 500;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0.5, 0, 1);">
                        <FontIcon iconLiteral="fas-search" iconSize="14" iconColor="#cbd5e1"/>
                        <TextField fx:id="searchField"
                                   promptText="Rechercher par marque, modèle, année..."
                                   style="-fx-background-color: transparent;
                                          -fx-border-width: 0;
                                          -fx-pref-width: 420;
                                          -fx-padding: 0 15;
                                          -fx-font-size: 14px;
                                          -fx-text-fill: #f1f5f9;
                                          -fx-prompt-text-fill: #94a3b8;
                                          -fx-font-family: 'Segoe UI', 'Arial', sans-serif;"/>
                    </HBox>

                    <!-- BOUTONS CONNEXION/INSCRIPTION -->
                    <HBox spacing="15" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">

                        <!-- Bouton Se Connecter -->
                        <Button fx:id="loginBtn"
                                onAction="#showLogin"
                                text="Se Connecter"
                                style="-fx-background-color: linear-gradient(to right, rgba(59, 130, 246, 0.1), rgba(37, 99, 235, 0.1));
                                       -fx-text-fill: #3b82f6;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: 600;
                                       -fx-cursor: hand;
                                       -fx-border-width: 1;
                                       -fx-border-color: rgba(59, 130, 246, 0.3);
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;
                                       -fx-padding: 10 20;
                                       -fx-min-width: 120;">
                            <graphic>
                                <FontIcon iconLiteral="fas-sign-in-alt" iconSize="14" iconColor="#3b82f6"/>
                            </graphic>
                        </Button>

                        <!-- Bouton S'Inscrire -->
                        <Button fx:id="registerBtn"
                                onAction="#showRegister"
                                text="S'Inscrire"
                                style="-fx-background-color: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
                                       -fx-text-fill: white;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: 600;
                                       -fx-cursor: hand;
                                       -fx-border-width: 0;
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;
                                       -fx-padding: 11 24;
                                       -fx-min-width: 120;
                                       -fx-effect: dropshadow(gaussian, rgba(139, 92, 246, 0.4), 8, 0.5, 0, 2);">
                            <graphic>
                                <FontIcon iconLiteral="fas-user-plus" iconSize="14" iconColor="white"/>
                            </graphic>
                        </Button>

                    </HBox>
                </HBox>

                <!-- NIVEAU 2 : MENU NAVIGATION POUR VISITEURS -->
                <HBox spacing="0" alignment="CENTER"
                      style="-fx-padding: 0 40; -fx-background-color: rgba(30, 41, 59, 0.8);">

                    <Button fx:id="homeBtn"
                            onAction="#showHome"
                            text="🏠 Accueil"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #3b82f6;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: 600;
                                   -fx-padding: 20 25;
                                   -fx-cursor: hand;
                                   -fx-border-width: 0 0 2 0;
                                   -fx-border-color: #3b82f6;"/>

                    <Button fx:id="vehiclesBtn"
                            onAction="#showVehicles"
                            text="🚗 Véhicules"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #cbd5e1;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: 500;
                                   -fx-padding: 20 25;
                                   -fx-cursor: hand;
                                   -fx-border-width: 0 0 2 0;
                                   -fx-border-color: transparent;"/>

                    <Button fx:id="promotionsBtn"
                            onAction="#showPromotions"
                            text="🔥 Promotions"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #cbd5e1;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: 500;
                                   -fx-padding: 20 25;
                                   -fx-cursor: hand;
                                   -fx-border-width: 0 0 2 0;
                                   -fx-border-color: transparent;"/>

                    <Button fx:id="aboutBtn"
                            onAction="#showAbout"
                            text="ℹ️ À Propos"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #cbd5e1;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: 500;
                                   -fx-padding: 20 25;
                                   -fx-cursor: hand;
                                   -fx-border-width: 0 0 2 0;
                                   -fx-border-color: transparent;"/>

                    <Button fx:id="contactBtn"
                            onAction="#showContact"
                            text="📞 Contact"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #cbd5e1;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: 500;
                                   -fx-padding: 20 25;
                                   -fx-cursor: hand;
                                   -fx-border-width: 0 0 2 0;
                                   -fx-border-color: transparent;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Mode Invité -->
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0;">
                        <FontIcon iconLiteral="fas-user-clock" iconSize="14" iconColor="#94a3b8"/>
                        <Label text="Mode Invité"
                               style="-fx-text-fill: #94a3b8;
                                      -fx-font-size: 13px;
                                      -fx-font-weight: 500;"/>
                    </HBox>
                </HBox>

                <!-- Ligne de séparation finale -->
                <Separator style="-fx-background-color: linear-gradient(to right, #334155, #475569, #334155);
                                 -fx-pref-height: 1;"/>
            </VBox>
        </top>

        <!-- CONTENU DYNAMIQUE (Page d'accueil par défaut) -->
        <center>
            <!-- Contenu de la page d'accueil sera chargé ici -->
            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="0" alignment="TOP_CENTER">

                    <!-- HERO SECTION -->
                    <StackPane style="-fx-background-color: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
                                      -fx-padding: 80 40;">
                        <VBox spacing="25" alignment="CENTER">
                            <Label text="Trouvez la Voiture de Vos Rêves"
                                   style="-fx-text-fill: white;
                                          -fx-font-size: 48px;
                                          -fx-font-weight: bold;
                                          -fx-text-alignment: center;
                                          -fx-wrap-text: true;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0.5, 0, 2);"/>

                            <Label text="Explorez notre sélection premium de véhicules neufs et d'occasion"
                                   style="-fx-text-fill: #cbd5e1;
                                          -fx-font-size: 18px;
                                          -fx-text-alignment: center;
                                          -fx-wrap-text: true;"/>

                            <HBox spacing="20" alignment="CENTER" style="-fx-padding: 30 0;">
                                <Button text="Parcourir les Véhicules"
                                        onAction="#showVehicles"
                                        style="-fx-background-color: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
                                               -fx-text-fill: white;
                                               -fx-font-size: 16px;
                                               -fx-font-weight: 600;
                                               -fx-padding: 15 30;
                                               -fx-background-radius: 10;
                                               -fx-effect: dropshadow(gaussian, rgba(139, 92, 246, 0.4), 15, 0.7, 0, 4);"/>

                                <Button text="Voir les Promotions"
                                        onAction="#showPromotions"
                                        style="-fx-background-color: transparent;
                                               -fx-text-fill: #3b82f6;
                                               -fx-font-size: 16px;
                                               -fx-font-weight: 600;
                                               -fx-border-width: 2;
                                               -fx-border-color: #3b82f6;
                                               -fx-border-radius: 10;
                                               -fx-background-radius: 10;
                                               -fx-padding: 15 30;"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- STATISTIQUES -->
                    <HBox spacing="40" alignment="CENTER"
                          style="-fx-background-color: rgba(30, 41, 59, 0.8);
                                 -fx-padding: 50 40;">

                        <VBox spacing="10" alignment="CENTER">
                            <Label text="500+"
                                   style="-fx-text-fill: #3b82f6;
                                          -fx-font-size: 36px;
                                          -fx-font-weight: bold;"/>
                            <Label text="Véhicules en Stock"
                                   style="-fx-text-fill: #cbd5e1;
                                          -fx-font-size: 14px;"/>
                        </VBox>

                        <Separator orientation="VERTICAL"
                                   style="-fx-background-color: #475569; -fx-pref-height: 40;"/>

                        <VBox spacing="10" alignment="CENTER">
                            <Label text="98%"
                                   style="-fx-text-fill: #10b981;
                                          -fx-font-size: 36px;
                                          -fx-font-weight: bold;"/>
                            <Label text="Clients Satisfaits"
                                   style="-fx-text-fill: #cbd5e1;
                                          -fx-font-size: 14px;"/>
                        </VBox>

                        <Separator orientation="VERTICAL"
                                   style="-fx-background-color: #475569; -fx-pref-height: 40;"/>

                        <VBox spacing="10" alignment="CENTER">
                            <Label text="24h"
                                   style="-fx-text-fill: #ec4899;
                                          -fx-font-size: 36px;
                                          -fx-font-weight: bold;"/>
                            <Label text="Support 24/7"
                                   style="-fx-text-fill: #cbd5e1;
                                          -fx-font-size: 14px;"/>
                        </VBox>

                        <Separator orientation="VERTICAL"
                                   style="-fx-background-color: #475569; -fx-pref-height: 40;"/>

                        <VBox spacing="10" alignment="CENTER">
                            <Label text="10+"
                                   style="-fx-text-fill: #8b5cf6;
                                          -fx-font-size: 36px;
                                          -fx-font-weight: bold;"/>
                            <Label text="Années d'Expérience"
                                   style="-fx-text-fill: #cbd5e1;
                                          -fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </center>
    </BorderPane>

</StackPane>