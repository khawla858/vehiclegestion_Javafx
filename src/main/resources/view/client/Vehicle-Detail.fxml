<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.client.controller.VehiDetaiCo"
            style="-fx-background-color: #0f172a;">

    <!-- CENTER: CONTENU PRINCIPAL -->
    <center>
        <VBox style="-fx-background-color: transparent;" spacing="0" VBox.vgrow="ALWAYS">

            <!-- Contenu principal avec ScrollPane -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <HBox fx:id="mainContainer" spacing="25" style="-fx-padding: 30;">

                    <!-- Section Gauche (70% de l'écran) -->
                    <VBox fx:id="leftSection" spacing="25" HBox.hgrow="ALWAYS"
                          style="-fx-max-width: Infinity; -fx-pref-width: 70%;">

                        <!-- Image principale -->
                        <VBox style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                     -fx-background-radius: 12;
                                     -fx-padding: 20;
                                     -fx-border-color: linear-gradient(to right, #8b5cf6, #3b82f6);
                                     -fx-border-width: 1.5;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(139, 92, 246, 0.2), 15, 0.5, 0, 5);">
                            <ImageView fx:id="mainImageView"
                                       fitWidth="1000" fitHeight="500"
                                       preserveRatio="true"
                                       style="-fx-background-radius: 8;"/>
                            <HBox spacing="10" style="-fx-padding: 15 0 0 0;" alignment="CENTER_LEFT">
                                <Rectangle width="3" height="16" arcWidth="2" arcHeight="2"
                                           style="-fx-fill: linear-gradient(to bottom, #8b5cf6, #3b82f6);"/>
                                <Label text="📷 Galerie photos"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                            </HBox>
                        </VBox>

                        <!-- Titre et localisation -->
                        <VBox spacing="12" style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                                 -fx-background-radius: 12;
                                                 -fx-padding: 25;
                                                 -fx-border-color: linear-gradient(to right, #3b82f6, #1e40af);
                                                 -fx-border-width: 1.5;
                                                 -fx-border-radius: 12;
                                                 -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.2), 15, 0.5, 0, 5);">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Rectangle width="3" height="20" arcWidth="2" arcHeight="2"
                                           style="-fx-fill: linear-gradient(to bottom, #ec4899, #8b5cf6);"/>
                                <Label fx:id="titleLabel" text="Titre du véhicule" wrapText="true"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                            </HBox>
                            <HBox spacing="20" alignment="CENTER_LEFT">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="📍" style="-fx-font-size: 14px; -fx-text-fill: #8b5cf6;"/>
                                    <Label fx:id="locationLabel" text="Casablanca"
                                           style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="📅" style="-fx-font-size: 14px; -fx-text-fill: #3b82f6;"/>
                                    <Label fx:id="dateLabel" text="Publiée aujourd'hui"
                                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Caractéristiques -->
                        <VBox fx:id="characteristicsContainer" spacing="15"
                              style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                     -fx-background-radius: 12;
                                     -fx-padding: 25;
                                     -fx-border-color: linear-gradient(to right, #ec4899, #8b5cf6);
                                     -fx-border-width: 1.5;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(236, 72, 153, 0.2), 15, 0.5, 0, 5);">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Rectangle width="3" height="20" arcWidth="2" arcHeight="2"
                                           style="-fx-fill: linear-gradient(to bottom, #ec4899, #8b5cf6);"/>
                                <Label text="Caractéristiques"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                            </HBox>
                            <!-- Rempli dynamiquement -->
                        </VBox>

                        <!-- Description -->
                        <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                                 -fx-background-radius: 12;
                                                 -fx-padding: 25;
                                                 -fx-border-color: linear-gradient(to right, #3b82f6, #1e40af);
                                                 -fx-border-width: 1.5;
                                                 -fx-border-radius: 12;
                                                 -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.2), 15, 0.5, 0, 5);">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Rectangle width="3" height="20" arcWidth="2" arcHeight="2"
                                           style="-fx-fill: linear-gradient(to bottom, #3b82f6, #1e40af);"/>
                                <Label text="Description"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f1f5f9;"/>
                            </HBox>
                            <Label fx:id="descriptionLabel" wrapText="true"
                                   style="-fx-font-size: 14px; -fx-text-fill: #cbd5e1; -fx-line-spacing: 1.5;"/>
                        </VBox>

                        <!-- Section Commentaires -->
                        <VBox fx:id="commentairesSection" spacing="20">
                            <!-- Rempli dynamiquement -->
                        </VBox>

                    </VBox>

                    <!-- Section Droite (30% de l'écran) -->
                    <VBox spacing="25" style="-fx-min-width: 30%; -fx-max-width: 400;">

                        <!-- Prix et bouton contact -->
                        <VBox spacing="18" style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                                 -fx-background-radius: 12;
                                                 -fx-padding: 25;
                                                 -fx-border-color: linear-gradient(to right, #ec4899, #8b5cf6);
                                                 -fx-border-width: 1.5;
                                                 -fx-border-radius: 12;
                                                 -fx-effect: dropshadow(gaussian, rgba(236, 72, 153, 0.2), 15, 0.5, 0, 5);">
                            <VBox spacing="5">
                                <Label fx:id="priceLabel" text="250 000 DH"
                                       style="-fx-font-size: 28px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: linear-gradient(to right, #ec4899, #8b5cf6);"/>
                                <Label text="À partir de 4 520 DH / mois"
                                       style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                            </VBox>

                            <!-- Séparateur -->
                            <Rectangle height="1" width="100"
                                       style="-fx-fill: linear-gradient(to right, transparent, #475569, transparent);" />

                            <Button fx:id="contactBtn" text="💬 Contacter le vendeur"
                                    style="-fx-background-color: linear-gradient(to right, #8b5cf6, #3b82f6);
                                           -fx-text-fill: white;
                                           -fx-padding: 14 30;
                                           -fx-background-radius: 8;
                                           -fx-font-weight: bold;
                                           -fx-cursor: hand;
                                           -fx-font-size: 14px;
                                           -fx-max-width: Infinity;
                                           -fx-effect: dropshadow(gaussian, rgba(139, 92, 246, 0.3), 10, 0.5, 0, 3);"/>

                        </VBox>

                        <!-- Section Vendeur -->
                        <VBox fx:id="sellerSection" spacing="18"
                              style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                     -fx-background-radius: 12;
                                     -fx-padding: 25;
                                     -fx-border-color: linear-gradient(to right, #3b82f6, #1e40af);
                                     -fx-border-width: 1.5;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.2), 15, 0.5, 0, 5);">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <StackPane>
                                    <Rectangle width="60" height="60" arcWidth="30" arcHeight="30"
                                               style="-fx-fill: radial-gradient(center 50% 50%, radius 80,
                                                                               rgba(139, 92, 246, 0.9),
                                                                               rgba(59, 130, 246, 0.7));"/>
                                    <Label text="V" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px;"/>
                                </StackPane>
                                <VBox spacing="6">
                                    <Label text="Vendeur Professionnel"
                                           style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #f1f5f9;"/>
                                    <HBox spacing="6" alignment="CENTER_LEFT">
                                        <Label text="⭐" style="-fx-text-fill: #8b5cf6; -fx-font-size: 14px;"/>
                                        <Label text="Membre depuis 2020"
                                               style="-fx-text-fill: #8b5cf6; -fx-font-size: 13px;"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <VBox spacing="8" style="-fx-background-color: rgba(139, 92, 246, 0.1);
                                                    -fx-padding: 15;
                                                    -fx-background-radius: 8;
                                                    -fx-border-color: rgba(139, 92, 246, 0.3);
                                                    -fx-border-width: 1;
                                                    -fx-border-radius: 8;">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="⚠️" style="-fx-font-size: 16px; -fx-text-fill: #8b5cf6;"/>
                                    <Label text="Important"
                                           style="-fx-font-weight: bold; -fx-text-fill: #8b5cf6;"/>
                                </HBox>
                                <Label text="Il ne faut jamais envoyer d'argent ni d'avance en cas de transfert."
                                       wrapText="true"
                                       style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px;"/>
                            </VBox>

                            <VBox spacing="12" style="-fx-padding: 10 0 0 0;">
                                <Button text="📅 Prendre rendez-vous"
                                        onAction="#handleRendezvous"
                                        style="-fx-background-color: linear-gradient(to right, #3b82f6, #1e40af);
                                               -fx-text-fill: white;
                                               -fx-padding: 12 20;
                                               -fx-background-radius: 8;
                                               -fx-font-weight: bold;
                                               -fx-cursor: hand;
                                               -fx-font-size: 14px;
                                               -fx-max-width: Infinity;
                                               -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 10, 0.5, 0, 3);"/>

                                <Button fx:id="chatBtn" text="💬 Contacter le Vendeur"
                                        onAction="#handleContact"
                                        style="-fx-background-color: linear-gradient(to right, #8b5cf6, #3b82f6);
                                               -fx-text-fill: white;
                                               -fx-padding: 12 20;
                                               -fx-background-radius: 8;
                                               -fx-font-weight: bold;
                                               -fx-cursor: hand;
                                               -fx-font-size: 14px;
                                               -fx-max-width: Infinity;
                                               -fx-effect: dropshadow(gaussian, rgba(139, 92, 246, 0.3), 10, 0.5, 0, 3);"/>

                                <Button fx:id="visiterMagasinBtn" text="🏪 Visiter Magasin"
                                        onAction="#handleVisiterMagasin"
                                        style="-fx-background-color: linear-gradient(to right, #ec4899, #8b5cf6);
                                               -fx-text-fill: white;
                                               -fx-padding: 12 20;
                                               -fx-background-radius: 8;
                                               -fx-font-weight: bold;
                                               -fx-cursor: hand;
                                               -fx-font-size: 14px;
                                               -fx-max-width: Infinity;
                                               -fx-effect: dropshadow(gaussian, rgba(236, 72, 153, 0.3), 10, 0.5, 0, 3);"/>
                            </VBox>
                        </VBox>

                        <!-- Statistiques -->
                        <VBox spacing="15" style="-fx-background-color: rgba(30, 41, 59, 0.9);
                                                 -fx-background-radius: 12;
                                                 -fx-padding: 25;
                                                 -fx-border-color: linear-gradient(to right, #ec4899, #8b5cf6);
                                                 -fx-border-width: 1.5;
                                                 -fx-border-radius: 12;
                                                 -fx-effect: dropshadow(gaussian, rgba(236, 72, 153, 0.2), 15, 0.5, 0, 5);">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Rectangle width="3" height="16" arcWidth="2" arcHeight="2"
                                           style="-fx-fill: linear-gradient(to bottom, #ec4899, #8b5cf6);"/>
                                <Label text="📊 Statistiques"
                                       style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #f1f5f9;"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="👁" style="-fx-font-size: 16px; -fx-text-fill: #8b5cf6;"/>
                                <Label text="1 234 vues"
                                       style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;"/>
                            </HBox>
                        </VBox>

                    </VBox>

                </HBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>