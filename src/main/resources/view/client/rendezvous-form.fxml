<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.paint.*?>

<VBox fx:id="mainContainer" spacing="0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.vehiclegestion.client.controller.RendezVousFormController">

    <!-- En-tête avec fond coloré -->
    <VBox style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2); -fx-padding: 15; -fx-alignment: center;">
        <Label text="📅" style="-fx-font-size: 32px; -fx-text-fill: white;"/>
        <Label fx:id="titleLabel" text="Prendre un Rendez-vous" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-alignment: center;"/>
        <Label fx:id="vehicleInfoLabel" text="Véhicule sélectionné" style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.9); -fx-alignment: center; -fx-padding: 8 0 0 0;"/>
    </VBox>

    <!-- Contenu du formulaire -->
    <VBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-padding: 20;">

        <!-- Carte du formulaire -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3); -fx-padding: 20;">

            <Label text="Détails du rendez-vous" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 10 0;"/>

            <GridPane hgap="15" vgap="12">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200" prefWidth="200" />
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints minHeight="35" prefHeight="35" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="35" prefHeight="35" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="35" prefHeight="35" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="35" prefHeight="35" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="80" prefHeight="80" vgrow="SOMETIMES" />
                </rowConstraints>

                <!-- Date -->
                <Label text="📅 Date du rendez-vous *" style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <DatePicker fx:id="datePicker" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 6; -fx-padding: 8; -fx-font-size: 13px;" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <!-- Heure -->
                <Label text="🕒 Heure *" style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="timeComboBox" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 6; -fx-padding: 8; -fx-font-size: 13px;" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <!-- Durée -->
                <Label text="⏱️ Durée estimée *" style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox fx:id="durationComboBox" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 6; -fx-padding: 8; -fx-font-size: 13px;" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <!-- Type de rendez-vous -->
                <Label text="🎯 Type de rendez-vous *" style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px;" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <ComboBox fx:id="typeRdvComboBox" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 6; -fx-padding: 8; -fx-font-size: 13px;" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <!-- Description -->
                <Label text="📝 Notes supplémentaires" style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px;" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextArea fx:id="descriptionTextArea" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-pref-height: 70;" GridPane.rowIndex="4" GridPane.columnIndex="1" />
            </GridPane>

            <!-- Informations importantes -->
            <VBox style="-fx-background-color: #e3f2fd; -fx-background-radius: 6; -fx-padding: 12; -fx-spacing: 6; -fx-margin: 15 0 0 0;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="💡" style="-fx-font-size: 14px;"/>
                    <Label text="Informations importantes" style="-fx-font-weight: bold; -fx-text-fill: #1565c0; -fx-font-size: 13px;"/>
                </HBox>
                <Label text="• Veuillez arriver 5 minutes avant l'heure prévue\n• Apportez votre permis de conduire pour les essais routiers\n• Le vendeur vous confirmera le rendez-vous par email"
                       style="-fx-text-fill: #1976d2; -fx-font-size: 12px; -fx-line-spacing: 1.2;"
                       wrapText="true" />
            </VBox>
        </VBox>

        <!-- Boutons d'action -->
        <HBox spacing="12" alignment="CENTER">
            <Button fx:id="cancelBtn" text="Annuler" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>
            <Button fx:id="submitBtn" text="Confirmer le Rendez-vous" style="-fx-background-color: linear-gradient(to bottom right, #28a745, #20c997); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(40,167,69,0.3), 6, 0, 0, 2);"/>
        </HBox>
    </VBox>

    <!-- Message de succès (caché par défaut) -->
    <VBox fx:id="successMessage" spacing="15" alignment="CENTER" managed="false" visible="false" style="-fx-background-color: linear-gradient(to bottom right, #d4edda, #c3e6cb); -fx-padding: 30; -fx-alignment: center;">
        <Label text="✅" style="-fx-font-size: 48px;"/>
        <VBox spacing="8" alignment="CENTER">
            <Label text="Rendez-vous Confirmé !" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #155724;"/>
            <Label text="Votre rendez-vous a été planifié avec succès. Vous recevrez un email de confirmation dans les plus brefs délais."
                   style="-fx-text-fill: #155724; -fx-text-alignment: center; -fx-font-size: 13px; -fx-line-spacing: 1.3;"
                   wrapText="true" />
        </VBox>
        <Button text="Fermer" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);"/>
    </VBox>
</VBox>