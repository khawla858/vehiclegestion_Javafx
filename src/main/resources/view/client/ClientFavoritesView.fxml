<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.Glow?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.client.controller.ClientFavoritesController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- Header COMPLÈTEMENT SUPPRIMÉ -->
    <!-- <top> section has been removed entirely -->

    <!-- Contenu principal -->
    <center>
        <StackPane>
            <!-- Grille de véhicules favoris -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent;">

                <VBox spacing="25" style="-fx-padding: 30;">
                    <GridPane fx:id="favoritesGrid" hgap="25" vgap="25">
                        <!-- Les cartes de véhicules seront ajoutées ici dynamiquement -->
                    </GridPane>
                </VBox>
            </ScrollPane>

            <!-- État vide (affiché quand aucun favori) -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="25"
                  visible="false" managed="false"
                  style="-fx-background-color: transparent; -fx-padding: 80;">

                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: rgba(30, 41, 59, 0.8);
                             -fx-background-radius: 20;
                             -fx-border-color: linear-gradient(to right, #ec4899, #8b5cf6);
                             -fx-border-width: 2;
                             -fx-border-radius: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0.5, 0, 5);
                             -fx-padding: 60 40;">

                    <StackPane>
                        <Rectangle width="120" height="120" arcWidth="60" arcHeight="60"
                                   style="-fx-fill: radial-gradient(center 50% 50%, radius 80,
                                                                   rgba(236, 72, 153, 0.8),
                                                                   rgba(168, 85, 247, 0.6));
                                          -fx-effect: dropshadow(gaussian, rgba(236, 72, 153, 0.5), 30, 0.7, 0, 0);"/>
                        <Label text="❤️" style="-fx-font-size: 60px;">
                            <effect>
                                <Glow level="0.8"/>
                            </effect>
                        </Label>
                    </StackPane>

                    <VBox spacing="8" alignment="CENTER">
                        <Label text="Aucun favori pour le moment"
                               style="-fx-font-size: 28px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #f1f5f9;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.5, 0, 1);"/>

                        <Label text="Ajoutez des véhicules à vos favoris pour les retrouver facilement ici"
                               wrapText="true" textAlignment="CENTER" maxWidth="400"
                               style="-fx-font-size: 15px; -fx-text-fill: #cbd5e1; -fx-line-spacing: 1.5;"/>
                    </VBox>

                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 20 0 0 0;">
                        <Rectangle width="30" height="2"
                                   style="-fx-fill: linear-gradient(to right, transparent, #ec4899);"/>
                        <Label text="⭐"
                               style="-fx-text-fill: #f59e0b; -fx-font-size: 20px;"/>
                        <Rectangle width="30" height="2"
                                   style="-fx-fill: linear-gradient(to right, #8b5cf6, transparent);"/>
                    </HBox>

                    <!-- SUPPRIMÉ: Le bouton "Découvrir les véhicules" dans l'état vide -->
                    <!-- <Button text="🔍 Découvrir les véhicules" ... /> a été supprimé -->

                    <VBox spacing="12" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <HBox spacing="10" alignment="CENTER">
                            <Rectangle width="8" height="8" arcWidth="4" arcHeight="4"
                                       style="-fx-fill: #3b82f6;"/>
                            <Label text="Parcourez notre sélection exclusive"
                                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px;"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER">
                            <Rectangle width="8" height="8" arcWidth="4" arcHeight="4"
                                       style="-fx-fill: #10b981;"/>
                            <Label text="Ajoutez vos préférés en un clic"
                                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px;"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER">
                            <Rectangle width="8" height="8" arcWidth="4" arcHeight="4"
                                       style="-fx-fill: #f59e0b;"/>
                            <Label text="Recevez des notifications personnalisées"
                                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </StackPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color: rgba(15, 23, 42, 0.9);
                     -fx-padding: 20 40;
                     -fx-border-color: linear-gradient(to right, #334155, transparent, #334155);
                     -fx-border-width: 1 0 0 0;">

            <Label text="© 2024 Gestion Véhicules Pro - Collection personnelle"
                   style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Hyperlink text="🔔 Notifications"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-cursor: hand;"/>
                <Label text="•" style="-fx-text-fill: #475569; -fx-font-size: 10px;"/>
                <Hyperlink text="📊 Comparer"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-cursor: hand;"/>
                <Label text="•" style="-fx-text-fill: #475569; -fx-font-size: 10px;"/>
                <Hyperlink text="⚙️ Gérer"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </bottom>

</BorderPane>
