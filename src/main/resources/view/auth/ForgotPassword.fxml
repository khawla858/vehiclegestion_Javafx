<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.vehiclegestion.auth.controller.ForgotPasswordController"
      style="-fx-background-color: #f2f2f2; -fx-padding: 40;">

    <Label text="🔐 Réinitialisation du mot de passe"
           style="-fx-font-size: 22px; -fx-font-weight: bold;" />

    <Label text="Entrez votre adresse email pour recevoir un lien de réinitialisation."
           wrapText="true"
           style="-fx-font-size: 14px;" />

    <TextField fx:id="emailField" promptText="Adresse email"
               style="-fx-padding: 10; -fx-pref-width: 280;" />

    <Label fx:id="messageLabel" textFill="red" visible="false" />

    <Button text="Envoyer"
            onAction="#handleSendReset"
            style="-fx-background-color: #2b6cb0; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14;" />

    <Button text="Retour"
            onAction="#handleBack"
            style="-fx-background-color: transparent; -fx-text-fill: #333; -fx-underline: true;" />
</VBox>
