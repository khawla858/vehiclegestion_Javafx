<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.vehiclegestion.common.controller.ChatWindowController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f0f2f5;">

    <!-- ============================================ -->
    <!-- SIDEBAR GAUCHE : LISTE DES CONVERSATIONS -->
    <!-- ============================================ -->
    <left>
        <VBox prefWidth="320" spacing="0"
              style="-fx-background-color: white;
                     -fx-border-color: #e4e6eb;
                     -fx-border-width: 0 1 0 0;">

            <!-- En-tête Sidebar -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 20;
                         -fx-border-color: #e4e6eb;
                         -fx-border-width: 0 0 1 0;">

                <Label text="💬 Messages"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1c1e21;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Badge notifications -->
                <Label fx:id="badgeNotifications"
                       text="3"
                       visible="false"
                       style="-fx-background-color: #0084ff;
                              -fx-text-fill: white;
                              -fx-background-radius: 12;
                              -fx-padding: 4 8;
                              -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>
            </HBox>

            <!-- Barre de recherche -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-padding: 12 15;
                         -fx-background-color: #f0f2f5;">

                <TextField fx:id="searchConversationField"
                           promptText="🔍 Rechercher une conversation..."
                           style="-fx-pref-width: 280;
                                  -fx-padding: 10;
                                  -fx-background-radius: 20;
                                  -fx-border-radius: 20;
                                  -fx-background-color: white;
                                  -fx-border-color: #ccd0d5;
                                  -fx-border-width: 1;
                                  -fx-font-size: 14px;"/>
            </HBox>

            <!-- Liste des conversations (ScrollPane) -->
            <ScrollPane fitToWidth="true"
                        style="-fx-background-color: white;
                               -fx-background: white;"
                        VBox.vgrow="ALWAYS">

                <VBox fx:id="conversationsListContainer"
                      spacing="0"
                      style="-fx-background-color: white;">
                    <!-- Les conversations seront ajoutées dynamiquement ici -->
                </VBox>
            </ScrollPane>

        </VBox>
    </left>

    <!-- ============================================ -->
    <!-- CENTRE : UN SEUL StackPane AVEC TOUT -->
    <!-- ============================================ -->
    <center>
        <StackPane>

            <!-- ==========================================
                 PLACEHOLDER (Affiché quand aucune conversation sélectionnée)
                 ========================================== -->
            <VBox fx:id="placeholderView"
                  alignment="CENTER"
                  spacing="20"
                  visible="true"
                  managed="true"
                  style="-fx-background-color: #f0f2f5;">

                <Label text="💬"
                       style="-fx-font-size: 80px;
                              -fx-opacity: 0.3;"/>

                <Label text="Sélectionnez une conversation"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #65676b;"/>

                <Label text="Choisissez une conversation dans la liste pour commencer à discuter"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #8a8d91;
                              -fx-wrap-text: true;
                              -fx-text-alignment: center;"/>
            </VBox>

            <!-- ==========================================
                 INTERFACE DE CHAT (Cachée au départ)
                 ========================================== -->
            <VBox fx:id="chatContainer"
                  spacing="0"
                  visible="false"
                  managed="false"
                  style="-fx-background-color: #ffffff;">

                <!-- En-tête du chat (info interlocuteur) -->
                <HBox fx:id="chatHeader"
                      alignment="CENTER_LEFT"
                      spacing="12"
                      style="-fx-background-color: white;
                             -fx-padding: 15 20;
                             -fx-border-color: #e4e6eb;
                             -fx-border-width: 0 0 1 0;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">

                    <!-- Photo de profil -->
                    <StackPane style="-fx-background-color: #0084ff;
                                      -fx-background-radius: 25;
                                      -fx-pref-width: 50;
                                      -fx-pref-height: 50;">
                        <Label fx:id="avatarLabel"
                               text="JD"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: bold;"/>
                    </StackPane>

                    <!-- Infos interlocuteur -->
                    <VBox spacing="2">
                        <Label fx:id="interlocuteurNomLabel"
                               text="John Doe"
                               style="-fx-font-size: 16px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #1c1e21;"/>

                        <Label fx:id="interlocuteurStatusLabel"
                               text="En ligne"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: #65676b;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Boutons d'action -->
                    <HBox spacing="10">
                        <Button text="📞"
                                style="-fx-background-color: transparent;
                                       -fx-font-size: 18px;
                                       -fx-cursor: hand;"
                                onAction="#callInterlocuteur"/>

                        <Button text="ℹ️"
                                style="-fx-background-color: transparent;
                                       -fx-font-size: 18px;
                                       -fx-cursor: hand;"
                                onAction="#showInfos"/>
                    </HBox>
                </HBox>

                <!-- Zone des messages (ScrollPane) -->
                <ScrollPane fx:id="messagesScrollPane"
                            fitToWidth="true"
                            vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: #f0f2f5;
                                   -fx-background: #f0f2f5;"
                            VBox.vgrow="ALWAYS">

                    <VBox fx:id="messagesContainer"
                          spacing="8"
                          style="-fx-padding: 20;
                                 -fx-background-color: #f0f2f5;">
                        <!-- Les messages seront ajoutés dynamiquement ici -->
                    </VBox>
                </ScrollPane>

                <!-- Zone de saisie du message -->
                <HBox fx:id="messageInputArea"
                      alignment="CENTER_LEFT"
                      spacing="12"
                      style="-fx-background-color: white;
                             -fx-padding: 15 20;
                             -fx-border-color: #e4e6eb;
                             -fx-border-width: 1 0 0 0;">

                    <!-- Bouton ajouter fichier -->
                    <Button text="📎"
                            style="-fx-background-color: transparent;
                                   -fx-font-size: 20px;
                                   -fx-cursor: hand;"
                            onAction="#attachFile"/>

                    <!-- Champ de texte -->
                    <!-- REMPLACEZ lignes 152-158 : -->
                    <TextField fx:id="messageInputField"
                               promptText="Écrivez votre message..."
                               style="-fx-padding: 12 15;
                  -fx-background-radius: 20;
                  -fx-border-radius: 20;
                  -fx-background-color: #f0f2f5;
                  -fx-border-color: transparent;
                  -fx-font-size: 14px;"
                               HBox.hgrow="ALWAYS"/>

                    <!-- Bouton emoji -->
                    <Button text="😊"
                            style="-fx-background-color: transparent;
                                   -fx-font-size: 20px;
                                   -fx-cursor: hand;"
                            onAction="#showEmojiPicker"/>

                    <!-- Bouton envoyer -->

                </HBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>